# gh pr close 7 --repo alice/site
### read
POST https://api.github.com/graphql
accept: application/vnd.github.merge-info-preview+json, application/vnd.github.nebula-preview
content-type: application/json; charset=utf-8
graphql-features: merge_queue
user-agent: GitHub CLI 2.83.2

{"query":"\n\tquery PullRequestByNumber($owner: String!, $repo: String!, $pr_number: Int!) {\n\t\trepository(owner: $owner, name: $repo) {\n\t\t\tpullRequest(number: $pr_number) {state,number,title,isCrossRepository,headRefName,id}\n\t\t}\n\t}","variables":{"owner":"alice","pr_number":7,"repo":"site"}}

### write
POST https://api.github.com/graphql
accept: application/vnd.github.merge-info-preview+json, application/vnd.github.nebula-preview
content-type: application/json
graphql-features: merge_queue
user-agent: GitHub CLI 2.83.2

{"query":"mutation PullRequestClose($input:ClosePullRequestInput!){closePullRequest(input: $input){pullRequest{id}}}","variables":{"input":{"pullRequestId":"PR_kwDOAlice7"}}}


# gh pr review 7 --repo alice/site --approve
### read
POST https://api.github.com/graphql
accept: application/vnd.github.merge-info-preview+json, application/vnd.github.nebula-preview
content-type: application/json; charset=utf-8
graphql-features: merge_queue
user-agent: GitHub CLI 2.83.2

{"query":"\n\tquery PullRequestByNumber($owner: String!, $repo: String!, $pr_number: Int!) {\n\t\trepository(owner: $owner, name: $repo) {\n\t\t\tpullRequest(number: $pr_number) {id,number}\n\t\t}\n\t}","variables":{"owner":"alice","pr_number":7,"repo":"site"}}

### write
POST https://api.github.com/graphql
accept: application/vnd.github.merge-info-preview+json, application/vnd.github.nebula-preview
content-type: application/json
graphql-features: merge_queue
user-agent: GitHub CLI 2.83.2

{"query":"mutation PullRequestReviewAdd($input:AddPullRequestReviewInput!){addPullRequestReview(input:$input){clientMutationId}}","variables":{"input":{"pullRequestId":"PR_kwDOAlice7","body":"","event":"APPROVE"}}}


# gh pr create --repo alice/site --head melete/fix-login --base main --title Fix --body B
### read
POST https://api.github.com/graphql
accept: application/vnd.github.merge-info-preview+json, application/vnd.github.nebula-preview
content-type: application/json; charset=utf-8
graphql-features: merge_queue
user-agent: GitHub CLI 2.83.2

{"query":"\n\tfragment repo on Repository {\n\t\tid\n\t\tname\n\t\towner { login }\n\t\thasIssuesEnabled\n\t\tdescription\n\t\thasWikiEnabled\n\t\tviewerPermission\n\t\tdefaultBranchRef {\n\t\t\tname\n\t\t}\n\t}\n\n\tquery RepositoryInfo($owner: String!, $name: String!) {\n\t\trepository(owner: $owner, name: $name) {\n\t\t\t...repo\n\t\t\tparent {\n\t\t\t\t...repo\n\t\t\t}\n\t\t\tmergeCommitAllowed\n\t\t\trebaseMergeAllowed\n\t\t\tsquashMergeAllowed\n\t\t}\n\t}","variables":{"name":"site","owner":"alice"}}

### read
POST https://api.github.com/graphql
accept: application/vnd.github.merge-info-preview+json, application/vnd.github.nebula-preview
content-type: application/json; charset=utf-8
graphql-features: merge_queue
user-agent: GitHub CLI 2.83.2

{"query":"\n\tquery PullRequestForBranch($owner: String!, $repo: String!, $headRefName: String!, $states: [PullRequestState!]) {\n\t\trepository(owner: $owner, name: $repo) {\n\t\t\tpullRequests(headRefName: $headRefName, states: $states, first: 30, orderBy: { field: CREATED_AT, direction: DESC }) {\n\t\t\t\tnodes {url,id,number,state,baseRefName,headRefName,isCrossRepository,headRepositoryOwner{id,login,...on User{name}}}\n\t\t\t}\n\t\t\tdefaultBranchRef { name }\n\t\t}\n\t}","variables":{"headRefName":"melete/fix-login","owner":"alice","repo":"site","states":["OPEN"]}}

### write
POST https://api.github.com/graphql
accept: application/vnd.github.merge-info-preview+json, application/vnd.github.nebula-preview
content-type: application/json; charset=utf-8
graphql-features: merge_queue
user-agent: GitHub CLI 2.83.2

{"query":"\n\t\tmutation PullRequestCreate($input: CreatePullRequestInput!) {\n\t\t\tcreatePullRequest(input: $input) {\n\t\t\t\tpullRequest {\n\t\t\t\t\tid\n\t\t\t\t\turl\n\t\t\t\t}\n\t\t\t}\n\t}","variables":{"input":{"baseRefName":"main","body":"B","draft":false,"headRefName":"melete/fix-login","maintainerCanModify":true,"repositoryId":"R_kgDOAlice","title":"Fix"}}}

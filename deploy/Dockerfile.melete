# The Melete service: API, jobs, broker, gateway, connectors, knowledge, events.
#
# One process in v0.1 with separate modules and separate database roles. It sits
# on both networks: `edge` so a person can reach the API, `internal` so it can
# reach Postgres and be the runtime's only peer.

FROM oven/bun:1.3.13-slim

# Only the service controls the local engine socket. Runtime containers never receive it.
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production

WORKDIR /app

# Manifests first, so a source-only change does not re-resolve dependencies.
COPY package.json bun.lock ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/client/package.json packages/client/
COPY packages/knowledge/package.json packages/knowledge/
COPY packages/runtime-hermes/package.json packages/runtime-hermes/
COPY packages/skills/package.json packages/skills/
COPY apps/melete/package.json apps/melete/
COPY apps/mock-api/package.json apps/mock-api/
COPY apps/web/package.json apps/web/
COPY conformance/package.json conformance/
RUN bun install --frozen-lockfile --production

COPY tsconfig.base.json tsconfig.json ./
COPY packages/ packages/
COPY apps/ apps/

# Non-root. The service writes only to the mounted volumes.
RUN groupadd --gid 10001 runtime \
    && useradd --uid 10002 --gid 10001 --create-home --home-dir /home/melete melete \
    && mkdir -p /data/spaces /data/artifacts /work \
    && chown -R melete:runtime /data /app /work \
    && chmod 2770 /work

USER melete

EXPOSE 8787 8788

CMD ["bun", "run", "apps/melete/src/index.ts"]

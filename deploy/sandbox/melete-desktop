#!/usr/bin/env python3
"""The desktop inside a docker sandbox, driven one exec at a time by the service.

    melete-desktop screenshot            PNG of the whole screen on stdout
    melete-desktop stream --fps N        length-prefixed JPEG frames on stdout until the pipe closes
    melete-desktop info                  JSON: the screen, the window in front, whether a browser runs
    melete-desktop text                  JSON: what the screen says, from the page's accessibility tree or OCR
    melete-desktop open URL              open an address in the browser, starting it if needed
    melete-desktop click X Y BUTTON N    click N times with button 1, 2 or 3
    melete-desktop type TEXT             type into whatever has focus
    melete-desktop key KEY...            press keys, such as Return or ctrl+l
    melete-desktop scroll X Y STEPS      positive scrolls down, negative up
    melete-desktop input JSON            a person's live-view events, in order

Everything runs as the sandbox user against display :0. Nothing here reads a
credential, and the only socket it opens is to the browser's DevTools endpoint
on the loopback address inside this container; the browser reaches the
internet only through the proxy the sandbox was given, when it was given one.
"""

import base64
import hashlib
import http.client
import io
import json
import os
import re
import shutil
import socket
import struct
import subprocess
import sys
import tempfile
import time
import urllib.parse

DISPLAY = os.environ.get("DISPLAY", ":0")
WIDTH, HEIGHT = 1024, 768
BROWSER = shutil.which("chromium") or shutil.which("chromium-browser") or "chromium"
PROFILE = os.path.join(os.environ.get("HOME", "/home/agent"), ".config", "melete-browser")
# Where a browser profile keeps saved passwords, cards and addresses.
STORES = tuple(
    name + suffix
    for name in ("Login Data", "Login Data For Account", "Web Data")
    for suffix in ("", "-journal")
)

# The live view speaks DOM key names; xdotool speaks X keysyms.
KEYSYMS = {
    "Enter": "Return", "Backspace": "BackSpace", "Tab": "Tab", "Escape": "Escape",
    "Delete": "Delete", "Insert": "Insert", "Home": "Home", "End": "End",
    "PageUp": "Prior", "PageDown": "Next", "ArrowLeft": "Left", "ArrowRight": "Right",
    "ArrowUp": "Up", "ArrowDown": "Down", "Shift": "Shift_L", "Control": "Control_L",
    "Alt": "Alt_L", "Meta": "Super_L", "CapsLock": "Caps_Lock", " ": "space",
    "ContextMenu": "Menu",
}
for number in range(1, 13):
    KEYSYMS[f"F{number}"] = f"F{number}"


def fail(message, code=1):
    sys.stderr.write(message + "\n")
    sys.exit(code)


def xdotool(*args, check=True):
    result = subprocess.run(["xdotool", *args], capture_output=True, text=True, env=os.environ)
    if check and result.returncode != 0:
        fail(f"xdotool {args[0]} failed: {result.stderr.strip()[:200]}")
    return result.stdout.strip()


def wait_for_display(seconds=20):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if subprocess.run(["xdotool", "getdisplaygeometry"], capture_output=True).returncode == 0:
            return
        time.sleep(0.2)
    fail("the desktop did not start")


def grab():
    from PIL import ImageGrab

    return ImageGrab.grab(xdisplay=DISPLAY)


def browser_running():
    uid = str(os.getuid())
    return subprocess.run(["pgrep", "-u", uid, "-x", "chromium"], capture_output=True).returncode == 0


def active_window():
    result = subprocess.run(["xdotool", "getactivewindow", "getwindowname"], capture_output=True, text=True)
    return result.stdout.strip()[:300] if result.returncode == 0 else ""


def screenshot():
    image = grab()
    out = io.BytesIO()
    image.save(out, format="PNG", compress_level=6)
    sys.stdout.buffer.write(out.getvalue())


def stream(fps):
    period = 1.0 / max(1, min(10, fps))
    last_digest, last_sent = None, 0.0
    out = sys.stdout.buffer
    while True:
        started = time.monotonic()
        buffer = io.BytesIO()
        grab().convert("RGB").save(buffer, format="JPEG", quality=60)
        frame = buffer.getvalue()
        digest = hashlib.sha256(frame).digest()
        # An unchanged screen is sent again only now and then, so a new viewer is painted.
        if digest != last_digest or started - last_sent > 2.0:
            try:
                out.write(struct.pack(">I", len(frame)) + frame)
                out.flush()
            except BrokenPipeError:
                return
            last_digest, last_sent = digest, started
        time.sleep(max(0.0, period - (time.monotonic() - started)))


def info():
    print(json.dumps({
        "width": WIDTH,
        "height": HEIGHT,
        "window": active_window(),
        "browser": browser_running(),
    }))


# ---- what the screen says ------------------------------------------------
#
# A model that reads no pictures still has to know what is on the screen. The
# browser starts with its DevTools endpoint on the loopback address inside this
# container (the port it chose is written to DevToolsActivePort in its
# profile), and `text` reads the accessibility tree of the page in front from
# it: each element's role, name, value, state and box on the screen, with a
# reference that stays the same while the element does. Anything else in front,
# or a browser started without the endpoint, is read with OCR instead.
#
# What is printed is raw material: the service formats it, bounds it and marks
# it as the page's words, never the person's.

DEVTOOLS_PORT_FILE = os.path.join(PROFILE, "DevToolsActivePort")
#: Elements looked at, in page order, before their boxes are asked for.
MAX_CANDIDATES = 3000
#: Elements printed, of those on screen.
MAX_ELEMENTS = 600
#: Characters kept of a name or a value.
MAX_FIELD = 300
#: Roles that say nothing on their own; their text is kept by the nodes inside.
QUIET_ROLES = {
    "none", "generic", "presentation", "InlineTextBox", "LineBreak", "RootWebArea", "WebArea",
    "paragraph", "group", "Section", "div", "LayoutTable", "LayoutTableRow", "LayoutTableCell",
    "ListMarker", "sectionheader", "sectionfooter",
}
#: Roles a person acts on, kept even when they have no name.
CONTROL_ROLES = {
    "button", "link", "textbox", "searchbox", "combobox", "checkbox", "radio", "switch", "slider",
    "spinbutton", "tab", "menuitem", "menuitemcheckbox", "menuitemradio", "option", "listbox",
    "treeitem", "gridcell", "ComboBoxSelect", "ComboBoxMenuButton", "PopUpButton", "DisclosureTriangle",
}
#: Element states worth saying, as the accessibility tree names them.
STATES = ("focused", "checked", "pressed", "selected", "expanded", "disabled", "required", "invalid")


class DevToolsSocket:
    """Just enough of a WebSocket client for the DevTools protocol on the loopback address."""

    def __init__(self, url, timeout=5.0):
        parsed = urllib.parse.urlparse(url)
        if parsed.hostname not in ("127.0.0.1", "localhost", "::1"):
            raise OSError("the DevTools endpoint is not on this computer")
        self.sock = socket.create_connection((parsed.hostname, parsed.port), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode("ascii")
        target = parsed.path + (f"?{parsed.query}" if parsed.query else "")
        self.sock.sendall(
            (
                f"GET {target} HTTP/1.1\r\nHost: {parsed.hostname}:{parsed.port}\r\n"
                "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n"
            ).encode("ascii")
        )
        self.buffer = bytearray()
        while b"\r\n\r\n" not in self.buffer:
            self._fill()
        end = self.buffer.index(b"\r\n\r\n") + 4
        status = bytes(self.buffer[:end]).split(b"\r\n", 1)[0]
        del self.buffer[:end]
        if b" 101 " not in status + b" ":
            raise OSError("the DevTools endpoint refused the connection")
        self.last = 0

    def _fill(self):
        chunk = self.sock.recv(1 << 16)
        if not chunk:
            raise OSError("the DevTools endpoint closed the connection")
        self.buffer += chunk

    def _take(self, size):
        while len(self.buffer) < size:
            self._fill()
        out = bytes(self.buffer[:size])
        del self.buffer[:size]
        return out

    def _frame(self, opcode, data):
        header = bytearray([0x80 | opcode])
        size = len(data)
        if size < 126:
            header.append(0x80 | size)
        elif size < 1 << 16:
            header.append(0x80 | 126)
            header += struct.pack(">H", size)
        else:
            header.append(0x80 | 127)
            header += struct.pack(">Q", size)
        mask = os.urandom(4)
        header += mask
        self.sock.sendall(bytes(header) + bytes(byte ^ mask[index % 4] for index, byte in enumerate(data)))

    def send(self, method, params=None):
        self.last += 1
        self._frame(0x1, json.dumps({"id": self.last, "method": method, "params": params or {}}).encode("utf-8"))
        return self.last

    def receive(self):
        message = bytearray()
        while True:
            first, second = self._take(2)
            opcode, size = first & 0x0F, second & 0x7F
            if size == 126:
                size = struct.unpack(">H", self._take(2))[0]
            elif size == 127:
                size = struct.unpack(">Q", self._take(8))[0]
            mask = self._take(4) if second & 0x80 else None
            data = self._take(size)
            if mask:
                data = bytes(byte ^ mask[index % 4] for index, byte in enumerate(data))
            if opcode == 0x8:
                raise OSError("the DevTools endpoint closed the connection")
            if opcode == 0x9:
                self._frame(0xA, data)
                continue
            if opcode == 0xA:
                continue
            message += data
            if first & 0x80:
                return json.loads(message.decode("utf-8"))

    def answers(self, ids):
        """The results for these message ids, by id; an error answers None."""
        waiting, found = set(ids), {}
        while waiting:
            reply = self.receive()
            if reply.get("id") in waiting:
                waiting.discard(reply["id"])
                found[reply["id"]] = None if "error" in reply else reply.get("result", {})
        return found

    def call(self, method, params=None):
        sent = self.send(method, params)
        result = self.answers([sent])[sent]
        if result is None:
            raise OSError(f"DevTools could not {method}")
        return result

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def devtools_port(path=DEVTOOLS_PORT_FILE):
    try:
        with open(path, encoding="ascii") as handle:
            port = int(handle.readline().strip())
    except (OSError, ValueError):
        return None
    return port if 0 < port < 65536 else None


def page_target(port, window_title):
    """The page in the window in front: the one whose title the window shows, else the most recent."""
    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=3)
    try:
        connection.request("GET", "/json/list")
        listed = json.loads(connection.getresponse().read())
    finally:
        connection.close()
    targets = [entry for entry in listed if isinstance(entry, dict) and entry.get("type") == "page"]
    if not targets:
        return None
    for target in targets:
        title = target.get("title") or ""
        if title and window_title.startswith(title):
            return target
    return targets[0]


def clean(value):
    """One line of at most MAX_FIELD characters: a page cannot make one element look like two."""
    text = " ".join(str(value).split())
    return text if len(text) <= MAX_FIELD else text[: MAX_FIELD - 1] + "…"


def ax_value(node, key):
    entry = node.get(key)
    return entry.get("value") if isinstance(entry, dict) else None


def candidates(nodes):
    """The tree's elements worth saying, in page order: named, valued, or acted on."""
    by_id = {node.get("nodeId"): node for node in nodes}
    roots = [node for node in nodes if node.get("parentId") not in by_id]
    order, stack, seen = [], [root.get("nodeId") for root in reversed(roots)], set()
    while stack:
        node_id = stack.pop()
        if node_id in seen or node_id not in by_id:
            continue
        seen.add(node_id)
        order.append(by_id[node_id])
        stack.extend(reversed(by_id[node_id].get("childIds") or []))
    picked = []
    for node in order:
        if node.get("ignored") or not isinstance(node.get("backendDOMNodeId"), int):
            continue
        role = str(ax_value(node, "role") or "")
        name = clean(ax_value(node, "name") or "")
        value = ax_value(node, "value")
        value = clean(value) if value not in (None, "") else ""
        if role in QUIET_ROLES and not value:
            continue
        if role == "StaticText":
            # Text a link, a button or a field already says by its name or
            # value is said once, there.
            said, above = False, by_id.get(node.get("parentId"))
            for _ in range(3):
                if not above:
                    break
                if any(name in clean(ax_value(above, key) or "") for key in ("name", "value")):
                    said = True
                    break
                above = by_id.get(above.get("parentId"))
            if not name or said:
                continue
            role = "text"
        elif not name and not value and role not in CONTROL_ROLES:
            continue
        states = []
        for prop in node.get("properties") or []:
            key = prop.get("name")
            got = (prop.get("value") or {}).get("value")
            if key in STATES and got not in (None, False, "false"):
                states.append(key if got in (True, "true") else f"{key}={clean(got)}")
        picked.append(
            {"ref": f"n{node['backendDOMNodeId']}", "role": role, "name": name, "value": value,
             "states": states, "backend": node["backendDOMNodeId"]}
        )
        if len(picked) >= MAX_CANDIDATES:
            break
    return picked


def union(quads):
    xs = [quad[index] for quad in quads for index in range(0, len(quad) - 1, 2)]
    ys = [quad[index] for quad in quads for index in range(1, len(quad), 2)]
    return min(xs), min(ys), max(xs), max(ys)


def accessibility_view(port, window_title):
    """The page in front, element by element, with boxes in screen pixels; None when there is none."""
    target = page_target(port, window_title)
    if not target or not target.get("webSocketDebuggerUrl"):
        return None
    tools = DevToolsSocket(target["webSocketDebuggerUrl"])
    try:
        # A page still loading may have no document to ask yet: asked again, once.
        for attempt in range(2):
            frame = tools.call(
                "Runtime.evaluate",
                {
                    "expression": "JSON.stringify([screenX, screenY, outerWidth, outerHeight, innerWidth,"
                    " innerHeight, location.href, document.title, scrollY,"
                    " document.documentElement.scrollHeight])",
                    "returnByValue": True,
                },
            )
            said = (frame.get("result") or {}).get("value")
            if isinstance(said, str) or attempt:
                break
            time.sleep(0.5)
        sx, sy, outer_w, outer_h, inner_w, inner_h, url, title, scroll_y, page_h = json.loads(said)
        tools.call("Accessibility.enable")
        found = candidates(tools.call("Accessibility.getFullAXTree").get("nodes") or [])
        sent = {tools.send("DOM.getContentQuads", {"backendNodeId": item["backend"]}): item for item in found}
        answers = tools.answers(list(sent))
    finally:
        tools.close()
    # Page pixels to screen pixels: the window's place, then the browser's own
    # bars above the page and any border at the sides.
    side = max(0, (outer_w - inner_w) // 2)
    left, top = sx + side, sy + max(0, outer_h - inner_h - side)
    elements, offscreen = [], 0
    for sent_id, item in sent.items():
        quads = (answers.get(sent_id) or {}).get("quads") or []
        if not quads:
            continue
        x1, y1, x2, y2 = union(quads)
        x1, y1, x2, y2 = max(0, x1), max(0, y1), min(inner_w, x2), min(inner_h, y2)
        if x2 - x1 < 1 or y2 - y1 < 1:
            offscreen += 1
            continue
        if len(elements) >= MAX_ELEMENTS:
            continue
        element = {key: item[key] for key in ("ref", "role", "name") if item[key]}
        if item["value"]:
            element["value"] = item["value"]
        if item["states"]:
            element["states"] = item["states"]
        element["box"] = [round(left + x1), round(top + y1), round(x2 - x1), round(y2 - y1)]
        elements.append(element)
    return {
        "source": "accessibility",
        "url": str(url)[:2048],
        "title": clean(title),
        "scroll": {"top": round(scroll_y), "page_height": round(page_h), "view_height": round(inner_h)},
        "elements": elements,
        "offscreen": offscreen,
    }


def ocr_lines(tsv):
    """Tesseract's TSV as lines of text, each with its box."""
    lines, order = {}, []
    for row in tsv.splitlines()[1:]:
        cells = row.split("\t")
        if len(cells) < 12 or cells[0] != "5":
            continue
        word = cells[11].strip()
        try:
            confidence = float(cells[10])
            x, y, w, h = (int(cells[index]) for index in range(6, 10))
        except ValueError:
            continue
        if not word or confidence < 0:
            continue
        key = (cells[1], cells[2], cells[3], cells[4])
        if key not in lines:
            lines[key] = {"words": [], "x1": x, "y1": y, "x2": x + w, "y2": y + h}
            order.append(key)
        line = lines[key]
        line["words"].append(word)
        line["x1"], line["y1"] = min(line["x1"], x), min(line["y1"], y)
        line["x2"], line["y2"] = max(line["x2"], x + w), max(line["y2"], y + h)
    elements = []
    for index, key in enumerate(order[:MAX_ELEMENTS]):
        line = lines[key]
        elements.append({
            "ref": f"t{index + 1}",
            "role": "text",
            "name": clean(" ".join(line["words"])),
            "box": [line["x1"], line["y1"], line["x2"] - line["x1"], line["y2"] - line["y1"]],
        })
    return elements


def ocr_view(reason):
    if not shutil.which("tesseract"):
        return {"source": "none", "reason": f"{reason}, and no OCR is installed"}
    with tempfile.NamedTemporaryFile(suffix=".png", dir="/tmp") as shot:
        grab().save(shot.name, format="PNG")
        result = subprocess.run(
            ["tesseract", shot.name, "stdout", "--psm", "3", "tsv"],
            capture_output=True, text=True, timeout=45,
        )
    if result.returncode != 0:
        return {"source": "none", "reason": f"{reason}, and OCR failed: {result.stderr.strip()[:200]}"}
    return {"source": "ocr", "reason": reason, "elements": ocr_lines(result.stdout)}


def text():
    window = active_window()
    view = None
    port = devtools_port() if browser_running() else None
    if port is None:
        reason = "no browser with an accessibility tree is open"
    elif not window.endswith("Chromium"):
        reason = "the window in front is not the browser"
    else:
        try:
            view = accessibility_view(port, window[: -len("Chromium")].rstrip(" -–"))
            reason = "the browser showed no page"
        except (OSError, ValueError, KeyError, TypeError, IndexError) as error:
            reason = f"the browser's accessibility tree could not be read ({type(error).__name__})"
    if view is None:
        view = ocr_view(reason)
    view["window"] = window
    view["width"], view["height"] = WIDTH, HEIGHT
    print(json.dumps(view, ensure_ascii=False))


def browser_windows():
    found = subprocess.run(["xdotool", "search", "--onlyvisible", "--class", "[Cc]hromium"],
                           capture_output=True, text=True)
    return found.stdout.split() if found.returncode == 0 else []


# Titles a window shows before any page is in it.
BLANK_TITLES = {"", "chromium", "new tab - chromium", "about:blank - chromium", "untitled - chromium"}


def settled_title(before, seconds):
    """The title of the window in front once it moved off `before`, or the last one seen."""
    deadline = time.monotonic() + seconds
    title = active_window()
    while time.monotonic() < deadline:
        title = active_window()
        if title != before and title.lower() not in BLANK_TITLES:
            return title
        time.sleep(0.25)
    return title


def open_url(url):
    if not re.match(r"^https?://", url):
        fail("an address to open must start with http:// or https://")
    if browser_running() and browser_windows():
        # The address goes into the window in front, the way a person types it:
        # the address bar, the address, then Return. Handing it to a second
        # browser process opened nothing when the running one did not take it.
        before = active_window()
        xdotool("windowactivate", "--sync", browser_windows()[-1], check=False)
        xdotool("key", "--clearmodifiers", "ctrl+l")
        time.sleep(0.2)
        xdotool("type", "--delay", "4", "--", url)
        # Delete drops any completion the address bar added after the address.
        xdotool("key", "--clearmodifiers", "Delete", "Return")
    else:
        before = ""
        # A profile from a browser that is no longer running can still hold its
        # lock, which keeps a new one from opening the address.
        for name in ("SingletonLock", "SingletonSocket", "SingletonCookie"):
            try:
                os.unlink(os.path.join(PROFILE, name))
            except FileNotFoundError:
                pass
        # The browser's policy keeps it from saving passwords, cards or
        # addresses; anything an older image saved is removed before it starts.
        for name in STORES:
            try:
                os.unlink(os.path.join(PROFILE, "Default", name))
            except FileNotFoundError:
                pass
        flags = [
            f"--user-data-dir={PROFILE}",
            # The container is the boundary: it already runs whatever the agent
            # asks, under the engine's seccomp profile, which refuses the
            # namespaces Chromium's own sandbox would make.
            "--no-sandbox",
            "--test-type",
            "--no-first-run",
            "--no-default-browser-check",
            "--disable-gpu",
            "--disable-features=Translate,MediaRouter,OptimizationHints",
            "--password-store=basic",
            # The page's accessibility tree, for `text`: on the loopback
            # address inside this container, at a port written to the profile.
            "--remote-debugging-address=127.0.0.1",
            "--remote-debugging-port=0",
            "--window-position=0,0",
            f"--window-size={WIDTH},{HEIGHT}",
            "--start-maximized",
        ]
        proxy = os.environ.get("HTTPS_PROXY") or os.environ.get("https_proxy")
        if proxy:
            flags.append(f"--proxy-server={proxy}")
        os.makedirs(PROFILE, exist_ok=True)
        with open("/tmp/browser.log", "ab") as log:
            subprocess.Popen([BROWSER, *flags, url], stdout=log, stderr=log, start_new_session=True)
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline:
            if browser_windows():
                break
            time.sleep(0.25)
        else:
            fail("the browser did not open a window")
    # Whether the window moved to the address is checked, not assumed: the
    # title changes when a page, a picture or an error page takes its place.
    title = settled_title(before, 15)
    navigated = title != before and title.lower() not in BLANK_TITLES
    if navigated:
        # Let the page start painting before anyone looks.
        time.sleep(1.5)
        title = active_window()
    print(json.dumps({"opened": url, "navigated": navigated, "window": title, "browser": True}))


def number(value, low, high, what):
    try:
        parsed = int(value)
    except ValueError:
        fail(f"{what} must be a whole number")
    if parsed < low or parsed > high:
        fail(f"{what} must be from {low} to {high}")
    return parsed


def click(x, y, button, count):
    x, y = number(x, 0, WIDTH - 1, "x"), number(y, 0, HEIGHT - 1, "y")
    button, count = number(button, 1, 3, "button"), number(count, 1, 3, "count")
    xdotool("mousemove", "--sync", str(x), str(y), "click", "--repeat", str(count), "--delay", "80", str(button))
    print(json.dumps({"clicked": [x, y], "button": button, "count": count, "window": active_window()}))


def type_text(text):
    xdotool("type", "--delay", "8", "--", text)
    print(json.dumps({"typed": len(text), "window": active_window()}))


def keys(names):
    for name in names:
        if not re.match(r"^[A-Za-z0-9_+]{1,48}$", name):
            fail(f"not a key name: {name!r}")
    xdotool("key", "--delay", "40", "--", *names)
    print(json.dumps({"pressed": names, "window": active_window()}))


def scroll(x, y, steps):
    x, y = number(x, 0, WIDTH - 1, "x"), number(y, 0, HEIGHT - 1, "y")
    steps = number(steps, -50, 50, "steps")
    button = "5" if steps > 0 else "4"
    xdotool("mousemove", "--sync", str(x), str(y), "click", "--repeat", str(abs(steps)), "--delay", "30", button)
    print(json.dumps({"scrolled": steps, "window": active_window()}))


def live_input(raw):
    """A person's events from the live view, which is the same size as the screen."""
    events = json.loads(raw)
    if not isinstance(events, list) or len(events) > 200:
        fail("input is a list of at most 200 events")
    commands = []

    def point(event):
        return str(max(0, min(WIDTH - 1, int(event["x"])))), str(max(0, min(HEIGHT - 1, int(event["y"]))))

    for event in events:
        kind = event.get("k")
        if kind in ("move", "down", "up"):
            x, y = point(event)
            commands.append(["mousemove", x, y])
            button = str({0: 1, 1: 2, 2: 3}.get(event.get("button", 0), 1))
            if kind == "down":
                commands.append(["mousedown", button])
            elif kind == "up":
                commands.append(["mouseup", button])
        elif kind == "wheel":
            x, y = point(event)
            commands.append(["mousemove", x, y])
            dy, dx = float(event.get("dy", 0)), float(event.get("dx", 0))
            if dy:
                commands.append(["click", "--repeat", str(min(10, max(1, round(abs(dy) / 100)))), "5" if dy > 0 else "4"])
            if dx:
                commands.append(["click", "--repeat", str(min(10, max(1, round(abs(dx) / 100)))), "7" if dx > 0 else "6"])
        elif kind == "key":
            key = str(event.get("key", ""))
            text = event.get("text")
            if event.get("down") and isinstance(text, str) and len(key) == 1:
                # Printable keys arrive as text on the way down; the way up has nothing to do.
                commands.append(["type", "--", text])
                continue
            if len(key) == 1:
                continue
            keysym = KEYSYMS.get(key)
            if keysym:
                commands.append(["keydown" if event.get("down") else "keyup", keysym])
        elif kind == "text":
            commands.append(["type", "--delay", "4", "--", str(event.get("text", ""))[:4096]])
        elif kind == "touch":
            points = event.get("points") or []
            if points:
                x, y = point(points[0])
                commands.append(["mousemove", x, y])
                if event.get("phase") == "start":
                    commands.append(["mousedown", "1"])
            elif event.get("phase") == "end":
                commands.append(["mouseup", "1"])
    for command in commands:
        subprocess.run(["xdotool", *command], capture_output=True, env=os.environ)
    print(json.dumps({"accepted": len(events)}))


def main(argv):
    if not argv:
        fail(__doc__.strip())
    command, rest = argv[0], argv[1:]
    wait_for_display()
    if command == "screenshot" and not rest:
        return screenshot()
    if command == "stream":
        fps = 5
        if rest[:1] == ["--fps"] and len(rest) == 2:
            fps = number(rest[1], 1, 10, "fps")
        return stream(fps)
    if command == "info" and not rest:
        return info()
    if command == "text" and not rest:
        return text()
    if command == "open" and len(rest) == 1:
        return open_url(rest[0])
    if command == "click" and len(rest) == 4:
        return click(*rest)
    if command == "type" and len(rest) == 1:
        return type_text(rest[0])
    if command == "key" and rest:
        return keys(rest)
    if command == "scroll" and len(rest) == 3:
        return scroll(*rest)
    if command == "input" and len(rest) == 1:
        return live_input(rest[0])
    fail(f"unknown desktop command: {command}")


if __name__ == "__main__":
    main(sys.argv[1:])

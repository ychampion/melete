#!/usr/bin/env python3
"""The desktop inside a docker sandbox, driven one exec at a time by the service.

    melete-desktop screenshot            PNG of the whole screen on stdout
    melete-desktop stream --fps N        length-prefixed JPEG frames on stdout until the pipe closes
    melete-desktop info                  JSON: the screen, the window in front, whether a browser runs
    melete-desktop open URL              open an address in the browser, starting it if needed
    melete-desktop click X Y BUTTON N    click N times with button 1, 2 or 3
    melete-desktop type TEXT             type into whatever has focus
    melete-desktop key KEY...            press keys, such as Return or ctrl+l
    melete-desktop scroll X Y STEPS      positive scrolls down, negative up
    melete-desktop input JSON            a person's live-view events, in order

Everything runs as the sandbox user against display :0. Nothing here opens a
socket or reads a credential; the browser reaches the internet only through
the proxy the sandbox was given, when it was given one.
"""

import hashlib
import io
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import time

DISPLAY = os.environ.get("DISPLAY", ":0")
WIDTH, HEIGHT = 1024, 768
BROWSER = shutil.which("chromium") or shutil.which("chromium-browser") or "chromium"
PROFILE = os.path.join(os.environ.get("HOME", "/home/agent"), ".config", "melete-browser")

# The live view speaks DOM key names; xdotool speaks X keysyms.
KEYSYMS = {
    "Enter": "Return", "Backspace": "BackSpace", "Tab": "Tab", "Escape": "Escape",
    "Delete": "Delete", "Insert": "Insert", "Home": "Home", "End": "End",
    "PageUp": "Prior", "PageDown": "Next", "ArrowLeft": "Left", "ArrowRight": "Right",
    "ArrowUp": "Up", "ArrowDown": "Down", "Shift": "Shift_L", "Control": "Control_L",
    "Alt": "Alt_L", "Meta": "Super_L", "CapsLock": "Caps_Lock", " ": "space",
    "ContextMenu": "Menu",
}
for number in range(1, 13):
    KEYSYMS[f"F{number}"] = f"F{number}"


def fail(message, code=1):
    sys.stderr.write(message + "\n")
    sys.exit(code)


def xdotool(*args, check=True):
    result = subprocess.run(["xdotool", *args], capture_output=True, text=True, env=os.environ)
    if check and result.returncode != 0:
        fail(f"xdotool {args[0]} failed: {result.stderr.strip()[:200]}")
    return result.stdout.strip()


def wait_for_display(seconds=20):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if subprocess.run(["xdotool", "getdisplaygeometry"], capture_output=True).returncode == 0:
            return
        time.sleep(0.2)
    fail("the desktop did not start")


def grab():
    from PIL import ImageGrab

    return ImageGrab.grab(xdisplay=DISPLAY)


def browser_running():
    uid = str(os.getuid())
    return subprocess.run(["pgrep", "-u", uid, "-x", "chromium"], capture_output=True).returncode == 0


def active_window():
    result = subprocess.run(["xdotool", "getactivewindow", "getwindowname"], capture_output=True, text=True)
    return result.stdout.strip()[:300] if result.returncode == 0 else ""


def screenshot():
    image = grab()
    out = io.BytesIO()
    image.save(out, format="PNG", compress_level=6)
    sys.stdout.buffer.write(out.getvalue())


def stream(fps):
    period = 1.0 / max(1, min(10, fps))
    last_digest, last_sent = None, 0.0
    out = sys.stdout.buffer
    while True:
        started = time.monotonic()
        buffer = io.BytesIO()
        grab().convert("RGB").save(buffer, format="JPEG", quality=60)
        frame = buffer.getvalue()
        digest = hashlib.sha256(frame).digest()
        # An unchanged screen is sent again only now and then, so a new viewer is painted.
        if digest != last_digest or started - last_sent > 2.0:
            try:
                out.write(struct.pack(">I", len(frame)) + frame)
                out.flush()
            except BrokenPipeError:
                return
            last_digest, last_sent = digest, started
        time.sleep(max(0.0, period - (time.monotonic() - started)))


def info():
    print(json.dumps({
        "width": WIDTH,
        "height": HEIGHT,
        "window": active_window(),
        "browser": browser_running(),
    }))


def open_url(url):
    if not re.match(r"^https?://", url):
        fail("an address to open must start with http:// or https://")
    if browser_running():
        # A second invocation hands the address to the running browser as a new tab.
        subprocess.Popen([BROWSER, f"--user-data-dir={PROFILE}", url],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    else:
        flags = [
            f"--user-data-dir={PROFILE}",
            # The container is the boundary: it already runs whatever the agent
            # asks, under the engine's seccomp profile, which refuses the
            # namespaces Chromium's own sandbox would make.
            "--no-sandbox",
            "--test-type",
            "--no-first-run",
            "--no-default-browser-check",
            "--disable-gpu",
            "--disable-features=Translate,MediaRouter,OptimizationHints",
            "--password-store=basic",
            "--window-position=0,0",
            f"--window-size={WIDTH},{HEIGHT}",
            "--start-maximized",
        ]
        proxy = os.environ.get("HTTPS_PROXY") or os.environ.get("https_proxy")
        if proxy:
            flags.append(f"--proxy-server={proxy}")
        os.makedirs(PROFILE, exist_ok=True)
        with open("/tmp/browser.log", "ab") as log:
            subprocess.Popen([BROWSER, *flags, url], stdout=log, stderr=log, start_new_session=True)
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        found = subprocess.run(["xdotool", "search", "--onlyvisible", "--class", "[Cc]hromium"],
                               capture_output=True, text=True)
        if found.returncode == 0 and found.stdout.strip():
            break
        time.sleep(0.25)
    else:
        fail("the browser did not open a window")
    # Let the page start painting before anyone looks.
    time.sleep(2.0)
    print(json.dumps({"opened": url, "window": active_window(), "browser": True}))


def number(value, low, high, what):
    try:
        parsed = int(value)
    except ValueError:
        fail(f"{what} must be a whole number")
    if parsed < low or parsed > high:
        fail(f"{what} must be from {low} to {high}")
    return parsed


def click(x, y, button, count):
    x, y = number(x, 0, WIDTH - 1, "x"), number(y, 0, HEIGHT - 1, "y")
    button, count = number(button, 1, 3, "button"), number(count, 1, 3, "count")
    xdotool("mousemove", "--sync", str(x), str(y), "click", "--repeat", str(count), "--delay", "80", str(button))
    print(json.dumps({"clicked": [x, y], "button": button, "count": count, "window": active_window()}))


def type_text(text):
    xdotool("type", "--delay", "8", "--", text)
    print(json.dumps({"typed": len(text), "window": active_window()}))


def keys(names):
    for name in names:
        if not re.match(r"^[A-Za-z0-9_+]{1,48}$", name):
            fail(f"not a key name: {name!r}")
    xdotool("key", "--delay", "40", "--", *names)
    print(json.dumps({"pressed": names, "window": active_window()}))


def scroll(x, y, steps):
    x, y = number(x, 0, WIDTH - 1, "x"), number(y, 0, HEIGHT - 1, "y")
    steps = number(steps, -50, 50, "steps")
    button = "5" if steps > 0 else "4"
    xdotool("mousemove", "--sync", str(x), str(y), "click", "--repeat", str(abs(steps)), "--delay", "30", button)
    print(json.dumps({"scrolled": steps, "window": active_window()}))


def live_input(raw):
    """A person's events from the live view, which is the same size as the screen."""
    events = json.loads(raw)
    if not isinstance(events, list) or len(events) > 200:
        fail("input is a list of at most 200 events")
    commands = []

    def point(event):
        return str(max(0, min(WIDTH - 1, int(event["x"])))), str(max(0, min(HEIGHT - 1, int(event["y"]))))

    for event in events:
        kind = event.get("k")
        if kind in ("move", "down", "up"):
            x, y = point(event)
            commands.append(["mousemove", x, y])
            button = str({0: 1, 1: 2, 2: 3}.get(event.get("button", 0), 1))
            if kind == "down":
                commands.append(["mousedown", button])
            elif kind == "up":
                commands.append(["mouseup", button])
        elif kind == "wheel":
            x, y = point(event)
            commands.append(["mousemove", x, y])
            dy, dx = float(event.get("dy", 0)), float(event.get("dx", 0))
            if dy:
                commands.append(["click", "--repeat", str(min(10, max(1, round(abs(dy) / 100)))), "5" if dy > 0 else "4"])
            if dx:
                commands.append(["click", "--repeat", str(min(10, max(1, round(abs(dx) / 100)))), "7" if dx > 0 else "6"])
        elif kind == "key":
            key = str(event.get("key", ""))
            text = event.get("text")
            if event.get("down") and isinstance(text, str) and len(key) == 1:
                # Printable keys arrive as text on the way down; the way up has nothing to do.
                commands.append(["type", "--", text])
                continue
            if len(key) == 1:
                continue
            keysym = KEYSYMS.get(key)
            if keysym:
                commands.append(["keydown" if event.get("down") else "keyup", keysym])
        elif kind == "text":
            commands.append(["type", "--delay", "4", "--", str(event.get("text", ""))[:4096]])
        elif kind == "touch":
            points = event.get("points") or []
            if points:
                x, y = point(points[0])
                commands.append(["mousemove", x, y])
                if event.get("phase") == "start":
                    commands.append(["mousedown", "1"])
            elif event.get("phase") == "end":
                commands.append(["mouseup", "1"])
    for command in commands:
        subprocess.run(["xdotool", *command], capture_output=True, env=os.environ)
    print(json.dumps({"accepted": len(events)}))


def main(argv):
    if not argv:
        fail(__doc__.strip())
    command, rest = argv[0], argv[1:]
    wait_for_display()
    if command == "screenshot" and not rest:
        return screenshot()
    if command == "stream":
        fps = 5
        if rest[:1] == ["--fps"] and len(rest) == 2:
            fps = number(rest[1], 1, 10, "fps")
        return stream(fps)
    if command == "info" and not rest:
        return info()
    if command == "open" and len(rest) == 1:
        return open_url(rest[0])
    if command == "click" and len(rest) == 4:
        return click(*rest)
    if command == "type" and len(rest) == 1:
        return type_text(rest[0])
    if command == "key" and rest:
        return keys(rest)
    if command == "scroll" and len(rest) == 3:
        return scroll(*rest)
    if command == "input" and len(rest) == 1:
        return live_input(rest[0])
    fail(f"unknown desktop command: {command}")


if __name__ == "__main__":
    main(sys.argv[1:])

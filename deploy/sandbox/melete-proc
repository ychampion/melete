#!/usr/bin/env python3
"""Background processes in the agent's computer.

The service starts, reads, writes to and stops long-running processes through
this helper, one short command at a time. Each process has a directory under
the root the service names:

    pid, sid, boot, started   written once the process runs
    sidstart                  when its session's leader started, so a reused number is not it
    sup                       the supervisor's pid and start time
    half                      the size of one output segment, in bytes
    ring                      the newest segment's number
    out.0, out.1              the output ring: segment k lives in out.<k % 2>
    in                        a FIFO the process reads as its standard input
    exit                      its exit status, written atomically when it ends
    lock                      taken while the ring is written or read

Output is a ring of two files of `half` bytes each, so a chatty process never
holds more than twice that. A byte cursor counts every byte ever written; a
reader that asks for bytes that have rotated away is told how many it missed.

Creating the directory is the run-once guard: a second start of the same id
finds it there and starts nothing. A process killed by a signal exits 128 plus
the signal, so a TERM reads as 143. A computer that restarted has a different
boot token, and every process recorded under the old one is lost.

Every answer is one line of JSON on standard output. Only the standard library
is used, so any computer with python3 can run it.
"""

import base64
import errno
import fcntl
import json
import os
import re
import shutil
import signal
import stat
import subprocess
import sys
import time

VERSION = 1
NAME = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
REENTERED_EXIT = 111
# A directory whose process ended this long ago is removed at the next start.
PRUNE_SECONDS = 24 * 3600
LINE_LIMIT = 240
SIGNALS = {"TERM": signal.SIGTERM, "INT": signal.SIGINT, "HUP": signal.SIGHUP, "KILL": signal.SIGKILL}


def answer(value, code=0):
    sys.stdout.write(json.dumps(value, separators=(",", ":")) + "\n")
    sys.stdout.flush()
    sys.exit(code)


def refuse(message, code=2):
    answer({"v": VERSION, "ok": False, "error": message}, code)


def open_regular(path, flags=os.O_RDONLY):
    """Open a regular file and nothing else, never waiting: the computer's user owns these files."""
    fd = os.open(path, flags | os.O_NONBLOCK | os.O_NOFOLLOW)
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        raise OSError(f"{path} is not a regular file")
    return fd


def read_text(path, default=None):
    try:
        with os.fdopen(open_regular(path), "r", encoding="utf-8") as handle:
            return handle.read(4096).strip()
    except (OSError, UnicodeDecodeError):
        return default


def regular_size(path):
    try:
        info = os.lstat(path)
    except OSError:
        return 0
    return info.st_size if stat.S_ISREG(info.st_mode) else 0


def write_atomic(path, value):
    temporary = f"{path}.tmp"
    with open(temporary, "w", encoding="utf-8") as handle:
        handle.write(value)
    os.replace(temporary, path)


def stat_fields(pid):
    """The fields of /proc/<pid>/stat after the command name, or None."""
    try:
        with open(f"/proc/{pid}/stat", "rb") as handle:
            data = handle.read()
    except OSError:
        return None
    return data[data.rindex(b")") + 2 :].split()


def start_time(pid):
    fields = stat_fields(pid)
    return fields[19].decode() if fields else None


def boot_token():
    """The kernel's boot and the start of this computer's init, which a container restart changes."""
    boot = read_text("/proc/sys/kernel/random/boot_id", "")
    return f"{boot}:{start_time(1) or ''}"


def sessions():
    """Every process here, by the session it belongs to."""
    found = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        fields = stat_fields(entry)
        if fields:
            found.setdefault(fields[3].decode(), []).append(int(entry))
    return found


def check_name(value):
    if not NAME.match(value):
        refuse("a process id is 1 to 64 letters, digits, dashes or underscores")
    return value


def check_root(value):
    if not value.startswith("/") or any(part in ("", ".", "..") for part in value.split("/")[1:]):
        refuse("the process root must be an absolute path of plain segments")
    return value


class Ring:
    """The two-file output ring of one process directory."""

    def __init__(self, directory):
        self.directory = directory
        self.half = int(read_text(os.path.join(directory, "half"), "0") or 0)

    def path(self, segment):
        return os.path.join(self.directory, f"out.{segment % 2}")

    def lock(self, exclusive):
        handle = os.fdopen(
            open_regular(os.path.join(self.directory, "lock"), os.O_RDWR | os.O_CREAT), "a+"
        )
        fcntl.flock(handle, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
        return handle

    def state(self):
        """The newest segment, the byte cursor, and the oldest byte still held."""
        segment = int(read_text(os.path.join(self.directory, "ring"), "0") or 0)
        size = regular_size(self.path(segment))
        total = segment * self.half + size
        return segment, total, max(0, (segment - 1) * self.half)

    def read(self, cursor, limit):
        with self.lock(False):
            _, total, oldest = self.state()
            cursor = min(max(cursor, 0), total)
            dropped = max(0, oldest - cursor)
            cursor = max(cursor, oldest)
            chunks = []
            position = cursor
            while position < total and sum(len(chunk) for chunk in chunks) < limit:
                segment = position // self.half if self.half else 0
                offset = position - segment * self.half
                want = min(
                    limit - sum(len(chunk) for chunk in chunks),
                    (self.half - offset) if self.half else total - position,
                    total - position,
                )
                try:
                    with os.fdopen(open_regular(self.path(segment)), "rb") as handle:
                        handle.seek(offset)
                        chunk = handle.read(want)
                except OSError:
                    break
                if not chunk:
                    break
                chunks.append(chunk)
                position += len(chunk)
            return {"from": cursor, "next": position, "dropped": dropped, "total": total}, b"".join(chunks)

    def last_line(self):
        _, total, oldest = self.state()
        start = max(oldest, total - 4096)
        _, tail = self.read(start, total - start)
        for line in reversed(tail.decode("utf-8", "replace").replace("\r", "\n").split("\n")):
            line = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", line)
            line = "".join(ch for ch in line if ch == "\t" or ch >= " ").strip()
            if line:
                return line[:LINE_LIMIT]
        return None


class Writer:
    """The supervisor's side of the ring."""

    def __init__(self, directory, half):
        self.ring = Ring(directory)
        self.ring.half = half
        self.segment = 0
        self.size = 0
        self.handle = open(self.ring.path(0), "wb")

    def write(self, data):
        while data:
            room = self.ring.half - self.size
            if room <= 0:
                with self.ring.lock(True):
                    self.handle.close()
                    self.segment += 1
                    # Truncating the older file and naming the new segment
                    # happen under the lock, so a reader never mixes them.
                    self.handle = open(self.ring.path(self.segment), "wb")
                    write_atomic(os.path.join(self.ring.directory, "ring"), str(self.segment))
                self.size = 0
                continue
            piece = data[:room]
            with self.ring.lock(True):
                self.handle.write(piece)
                self.handle.flush()
            self.size += len(piece)
            data = data[room:]


def supervise(directory, cwd, command, half):
    """The process that owns the command: it starts it, keeps its output and records its end."""
    writer = Writer(directory, half)
    write_atomic(os.path.join(directory, "sup"), f"{os.getpid()} {start_time(os.getpid())}")
    fifo = os.open(os.path.join(directory, "in"), os.O_RDWR)
    try:
        child = subprocess.Popen(
            ["/bin/sh", "-c", command],
            cwd=cwd,
            stdin=fifo,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            start_new_session=True,
            close_fds=True,
        )
    except OSError as error:
        writer.write(f"melete-proc: the command could not start: {error.strerror or error}\n".encode())
        write_atomic(os.path.join(directory, "exit"), "127")
        return
    finally:
        os.close(fifo)
    write_atomic(os.path.join(directory, "pid"), str(child.pid))
    write_atomic(os.path.join(directory, "sid"), str(child.pid))
    write_atomic(os.path.join(directory, "sidstart"), start_time(child.pid) or "")
    write_atomic(os.path.join(directory, "boot"), boot_token())
    write_atomic(os.path.join(directory, "started"), str(int(time.time() * 1000)))
    stream = child.stdout.fileno()
    while True:
        try:
            chunk = os.read(stream, 65536)
        except InterruptedError:
            continue
        if not chunk:
            break
        try:
            writer.write(chunk)
        except OSError:
            # A full disk or a file-size limit drops output, never the process.
            pass
    code = child.wait()
    write_atomic(os.path.join(directory, "exit"), str(128 - code if code < 0 else code))


def daemonize(directory, cwd, command, half):
    """Run the supervisor detached from this command, its session and its output."""
    first = os.fork()
    if first:
        os.waitpid(first, 0)
        return
    os.setsid()
    if os.fork():
        os._exit(0)
    null = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(null, fd)
    os.close(null)
    try:
        supervise(directory, cwd, command, half)
    finally:
        os._exit(0)


def session_members(directory, members, boot):
    """The live processes of the command's session, and never another session that took its number.

    While any member lives the kernel keeps the session's number, so members
    found under it are the command's own. Once all are gone the number can be
    reused by a new leader; that leader started at another time.
    """
    sid = read_text(os.path.join(directory, "sid"))
    if not sid or read_text(os.path.join(directory, "boot")) != boot:
        return []
    recorded = read_text(os.path.join(directory, "sidstart"))
    leader = start_time(sid)
    if recorded and leader is not None and leader != recorded:
        return []
    return members.get(sid, [])


def describe(root, name, members, boot):
    """One process as the service sees it."""
    directory = os.path.join(root, name)
    ring = Ring(directory)
    _, total, oldest = ring.state()
    status = read_text(os.path.join(directory, "exit"))
    recorded = read_text(os.path.join(directory, "boot"))
    alive = session_members(directory, members, boot)
    if status is not None and re.match(r"^\d{1,3}$", status):
        state, code = "exited", int(status)
    elif recorded is not None and recorded != boot:
        state, code = "lost", None
    else:
        sup = (read_text(os.path.join(directory, "sup"), "") or "").split()
        running = len(sup) == 2 and start_time(sup[0]) == sup[1]
        state = "running" if running else ("starting" if not sup else "lost")
        code = None
    started = read_text(os.path.join(directory, "started"))
    return {
        "id": name,
        "state": state,
        "exit_code": code,
        "cursor": total,
        "oldest": oldest,
        "last_line": ring.last_line(),
        "ports": listening(alive) if state == "running" else [],
        "members": len(alive),
        "started": int(started) if started and started.isdigit() else None,
    }


def listening(pids):
    """The TCP ports the given processes listen on."""
    sockets = {}
    for table in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            with open(table, "r", encoding="ascii") as handle:
                next(handle, None)
                for line in handle:
                    fields = line.split()
                    if len(fields) > 9 and fields[3] == "0A":
                        sockets[fields[9]] = int(fields[1].rsplit(":", 1)[1], 16)
        except OSError:
            continue
    ports = set()
    for pid in pids:
        try:
            descriptors = os.listdir(f"/proc/{pid}/fd")
        except OSError:
            continue
        for fd in descriptors:
            try:
                target = os.readlink(f"/proc/{pid}/fd/{fd}")
            except OSError:
                continue
            if target.startswith("socket:[") and target[8:-1] in sockets:
                ports.add(sockets[target[8:-1]])
    return sorted(ports)


def prune(root):
    now = time.time()
    try:
        names = os.listdir(root)
    except OSError:
        return
    for name in names:
        exit_path = os.path.join(root, name, "exit")
        try:
            if NAME.match(name) and now - os.path.getmtime(exit_path) > PRUNE_SECONDS:
                shutil.rmtree(os.path.join(root, name), ignore_errors=True)
        except OSError:
            continue


def command_start(root, name, cwd, half, wait_ms, first_max, command):
    os.makedirs(root, mode=0o700, exist_ok=True)
    prune(root)
    directory = os.path.join(root, name)
    try:
        os.mkdir(directory, 0o700)
    except FileExistsError:
        answer({"v": VERSION, "ok": False, "error": "melete_exec_reentered"}, REENTERED_EXIT)
    write_atomic(os.path.join(directory, "half"), str(half))
    write_atomic(os.path.join(directory, "ring"), "0")
    open(os.path.join(directory, "out.0"), "wb").close()
    open(os.path.join(directory, "lock"), "a").close()
    os.mkfifo(os.path.join(directory, "in"), 0o600)
    daemonize(directory, cwd, command, half)
    deadline = time.monotonic() + wait_ms / 1000
    ring = Ring(directory)
    while True:
        ended = read_text(os.path.join(directory, "exit")) is not None
        _, total, _ = ring.state()
        if ended or total >= first_max or time.monotonic() >= deadline:
            break
        time.sleep(0.05)
    boot = boot_token()
    facts = describe(root, name, sessions(), boot)
    meta, data = ring.read(0, first_max)
    answer({
        "v": VERSION,
        "ok": True,
        "boot": boot,
        "process": facts,
        "read": meta,
        "data": base64.b64encode(data).decode(),
    })


def command_status(root, names):
    boot = boot_token()
    members = sessions()
    try:
        listed = sorted(entry for entry in os.listdir(root) if NAME.match(entry))
    except OSError:
        listed = []
    wanted = listed if names == ["--all"] else [name for name in names if name in listed]
    answer({
        "v": VERSION,
        "ok": True,
        "boot": boot,
        "processes": [describe(root, name, members, boot) for name in wanted],
        "missing": [] if names == ["--all"] else [name for name in names if name not in listed],
    })


def command_read(root, name, cursor, limit, wait_ms):
    directory = os.path.join(root, name)
    if not os.path.isdir(directory):
        refuse("no such process here", 3)
    ring = Ring(directory)
    if cursor < 0:
        # The newest output: the last `limit` bytes the ring holds, without waiting.
        _, total, _ = ring.state()
        cursor, wait_ms = max(0, total - limit), 0
    deadline = time.monotonic() + wait_ms / 1000
    while True:
        _, total, _ = ring.state()
        ended = read_text(os.path.join(directory, "exit")) is not None
        if total > cursor or ended or time.monotonic() >= deadline:
            break
        time.sleep(0.1)
    meta, data = ring.read(cursor, limit)
    boot = boot_token()
    answer({
        "v": VERSION,
        "ok": True,
        "boot": boot,
        "process": describe(root, name, sessions(), boot),
        "read": meta,
        "data": base64.b64encode(data).decode(),
    })


def command_write(root, name, encoded):
    directory = os.path.join(root, name)
    boot = boot_token()
    facts = describe(root, name, sessions(), boot) if os.path.isdir(directory) else None
    if not facts:
        refuse("no such process here", 3)
    if facts["state"] != "running":
        refuse(f"the process is {facts['state']}, so nothing can be written to it", 4)
    data = base64.b64decode(encoded)
    try:
        fd = os.open(os.path.join(directory, "in"), os.O_WRONLY | os.O_NONBLOCK)
    except OSError as error:
        refuse(f"the process input could not be opened: {error.strerror}", 4)
    written = 0
    try:
        while written < len(data):
            try:
                written += os.write(fd, data[written:])
            except BlockingIOError:
                break
    finally:
        os.close(fd)
    answer({"v": VERSION, "ok": True, "boot": boot, "written": written, "process": facts})


def send(root, name, members, boot, number):
    """Signal every process still in the command's session; never anything else."""
    directory = os.path.join(root, name)
    sent = 0
    for pid in session_members(directory, members, boot):
        try:
            os.kill(pid, number)
            sent += 1
        except OSError as error:
            if error.errno != errno.ESRCH:
                raise
    return sent


def command_signal(root, name, which):
    if which not in SIGNALS:
        refuse("the signal must be TERM, INT, HUP or KILL")
    if not os.path.isdir(os.path.join(root, name)):
        refuse("no such process here", 3)
    boot = boot_token()
    sent = send(root, name, sessions(), boot, SIGNALS[which])
    time.sleep(0.2)
    answer({
        "v": VERSION,
        "ok": True,
        "boot": boot,
        "sent": sent,
        "process": describe(root, name, sessions(), boot),
    })


def command_stop(root, name, grace_ms):
    """TERM, then KILL whatever is left once the grace has passed."""
    if not os.path.isdir(os.path.join(root, name)):
        refuse("no such process here", 3)
    boot = boot_token()
    directory = os.path.join(root, name)
    sent = send(root, name, sessions(), boot, signal.SIGTERM)
    deadline = time.monotonic() + grace_ms / 1000
    killed = 0
    while session_members(directory, sessions(), boot) and time.monotonic() < deadline:
        time.sleep(0.1)
    if session_members(directory, sessions(), boot):
        killed = send(root, name, sessions(), boot, signal.SIGKILL)
    # The supervisor writes the exit status once the output pipe closes.
    settle = time.monotonic() + 2
    while read_text(os.path.join(root, name, "exit")) is None and time.monotonic() < settle:
        time.sleep(0.05)
    answer({
        "v": VERSION,
        "ok": True,
        "boot": boot,
        "sent": sent,
        "killed": killed,
        "process": describe(root, name, sessions(), boot),
    })


def main(argv):
    if len(argv) < 2:
        refuse("usage: melete-proc <root> start|status|read|write|signal|stop ...")
    root, verb, rest = check_root(argv[0]), argv[1], argv[2:]
    if verb == "version":
        answer({"v": VERSION, "ok": True})
    if verb == "status":
        if rest != ["--all"]:
            rest = [check_name(name) for name in rest]
        command_status(root, rest)
    if verb == "start" and len(rest) == 6:
        name, cwd, half, wait_ms, first_max, command = rest
        command_start(root, check_name(name), cwd, int(half), int(wait_ms), int(first_max), command)
    if verb == "read" and len(rest) == 4:
        name, cursor, limit, wait_ms = rest
        command_read(root, check_name(name), int(cursor), int(limit), int(wait_ms))
    if verb == "write" and len(rest) == 2:
        command_write(root, check_name(rest[0]), rest[1])
    if verb == "signal" and len(rest) == 2:
        command_signal(root, check_name(rest[0]), rest[1])
    if verb == "stop" and len(rest) == 2:
        command_stop(root, check_name(rest[0]), int(rest[1]))
    refuse(f"unknown or malformed request: {verb}")


if __name__ == "__main__":
    main(sys.argv[1:])

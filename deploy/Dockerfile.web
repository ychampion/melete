# The web client.
#
# The owner builds the client separately; `apps/web` is not in this repository
# yet, which is why the `web` service in docker-compose.yml sits behind a
# profile. When it lands, this builds it and serves the static output.

FROM oven/bun:1.3.13-slim AS build

WORKDIR /app
COPY package.json bun.lock ./
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
RUN bun install --frozen-lockfile

COPY . .
RUN bun run --cwd apps/web build

FROM oven/bun:1.3.13-slim

WORKDIR /app
COPY --from=build /app/apps/web/dist ./dist

RUN useradd --uid 10003 --create-home --home-dir /home/web web
USER web

EXPOSE 3000

CMD ["bunx", "serve", "-s", "dist", "-l", "3000"]

# From the repository root:
#   bun run deploy/scripts/configure.ts [--fake] [--tailscale [--tailscale-hostname name]]
# Or copy this file to deploy/.env and fill every required value.
COMPOSE_PROJECT_NAME=melete

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Seals connection secrets and provider keys at rest. You hold it; losing it
# means re-entering every credential, which is the intended trade.
# Generate one with:  openssl rand -base64 32
MELETE_MASTER_KEY=

# Generate two independent values with: openssl rand -hex 32
# The API signs attempt capabilities; only the API holds the approval key.
MELETE_CAPABILITY_KEY=
MELETE_APPROVAL_KEY=

# Authenticates the warm runtime API. Real attempts get independent keys.
MELETE_RUNTIME_KEY=
# The trusted service supervises attempt containers; only it gets this group.
# Linux: stat -c %g /var/run/docker.sock
# Docker Desktop serves the socket from its VM, where its group is root (0);
# configure.ts measures it from a container.
DOCKER_GID=

POSTGRES_USER=melete
POSTGRES_PASSWORD=
POSTGRES_DB=melete
DATABASE_URL=postgres://melete:CHANGE_ME@postgres:5432/melete

# ---------------------------------------------------------------------------
# Ports on the host
# ---------------------------------------------------------------------------

MELETE_PORT=3100
WEB_PORT=3101
# Optional HTTPS origin when putting the loopback web service behind a proxy.
MELETE_WEB_ORIGIN=
# The web address sign-in links point at, for email sign-in (docs/CLIENT.md).
MELETE_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Tailscale
#
# Read only by deploy/docker-compose.tailscale.yml, which reaches the web client
# from your own devices over your tailnet with HTTPS and publishes no host port.
# See docs/DEPLOYMENT.md, "Tailscale".
#
# TS_AUTHKEY is an auth key from the Tailscale admin console, or an OAuth client
# secret with ?ephemeral=false. It is a secret: keep this file private.
#
# TS_HOSTNAME becomes the node name, so the address is
# https://<TS_HOSTNAME>.<your tailnet>.ts.net. Once the node has joined, run
# `bun run deploy/scripts/tailscale-origin.ts` to write MELETE_WEB_ORIGIN.
#
# TS_EXTRA_ARGS passes further flags to the node, for example
# --advertise-tags=tag:melete, which an OAuth client secret requires.
# ---------------------------------------------------------------------------

TS_AUTHKEY=
TS_HOSTNAME=melete
TS_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# Model providers
#
# Melete is model-agnostic. Keys are injected by the gateway proxy and never
# reach the runtime container. The fake provider is a deterministic local
# deployment check, enabled only with configure.ts --fake.
#
# MELETE_DEFAULT_PROVIDER is one of exactly these names, and needs the key
# beside it:
#   fireworks          FIREWORKS_API_KEY
#   anthropic          ANTHROPIC_API_KEY
#   openai             OPENAI_API_KEY
#   google             GOOGLE_API_KEY
#   chatgpt            none: the owner signs in to ChatGPT from Melete
#   openai-compatible  OPENAI_COMPAT_BASE_URL, and OPENAI_COMPAT_API_KEY
#                      or the OPENAI_COMPAT_OAUTH_ settings below
# Any other name, or openai-compatible without a usable address, stops the
# service at start-up with a message naming the setting. An empty key for the
# selected provider is reported at start-up as a warning, and every model call
# is refused until it is set.
#
# MELETE_DEFAULT_MODEL is the identifier that provider serves, written exactly
# as its API expects it. Fireworks identifiers are full account paths.
# ---------------------------------------------------------------------------

MELETE_DEFAULT_PROVIDER=fireworks
MELETE_DEFAULT_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
# The output limit given to a model request that names none, which is the usual
# ceiling on one reply. It is held against the job's output budget until the
# call settles, and never exceeds what the job has left.
MELETE_DEFAULT_MAX_OUTPUT_TOKENS=4096
MELETE_ENABLE_FAKE_PROVIDER=false
MELETE_ENABLE_TEST_CONNECTOR=false

# Engine limits for each attempt; empty keeps the default. docs/DEPLOYMENT.md,
# "Engine limits", says what each one does.
#   MELETE_ENGINE_MAX_TURNS       iterations one run may take (default 150)
#   MELETE_COMPACTION_MAX_TOKENS  conversation size that triggers a summary (default 200000)
#   MELETE_MODEL_CONTEXT_WINDOW   the served model's context window, when it is smaller
MELETE_ENGINE_MAX_TURNS=
MELETE_COMPACTION_MAX_TOKENS=
MELETE_MODEL_CONTEXT_WINDOW=

# Automatic memory reads what people say in chat with this model; empty uses the
# default provider and model, and `off` keeps structured observations only.
# MELETE_MEMORY_DAILY_CALLS is how many reads one person's memory may make a day.
MELETE_MEMORY_MODEL=
MELETE_MEMORY_PROVIDER=
MELETE_MEMORY_DAILY_CALLS=200

FIREWORKS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# One OpenAI-compatible endpoint of your choosing, selected with
# MELETE_DEFAULT_PROVIDER=openai-compatible whatever software serves it.
# Give the version prefix, for example https://models.example.net/v1
#
# This is the only provider address that may be plain http://, for a model
# server on your own machine or network, for example http://192.168.1.20:11434/v1
# Over http:// the key and every prompt travel unencrypted, so keep it to a
# network you trust. Inside Compose, localhost is the Melete container itself:
# use an address the container can reach.
#
# The gateway refuses a provider with an empty key. If your server checks no
# key, set OPENAI_COMPAT_API_KEY to any non-empty value. Left empty, an https://
# endpoint falls back to OPENAI_API_KEY; a plain http:// endpoint never
# receives OPENAI_API_KEY.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# The OAuth client ChatGPT sign-in presents. Left empty, it is the Codex CLI's
# public client, the one OpenAI has registered for this sign-in.
MELETE_CHATGPT_CLIENT_ID=

# OAuth for the OpenAI-compatible endpoint, for a provider that issues access
# tokens rather than keys. Register OPENAI_COMPAT_OAUTH_REDIRECT_URL with the
# provider, give its issuer (or its authorize and token addresses), and the
# owner signs in from Melete. The token is then used instead of
# OPENAI_COMPAT_API_KEY. Signing in needs MELETE_MASTER_KEY.
# OPENAI_COMPAT_OAUTH_LABEL names the provider on the sign-in button.
OPENAI_COMPAT_OAUTH_ISSUER=
OPENAI_COMPAT_OAUTH_AUTHORIZE_URL=
OPENAI_COMPAT_OAUTH_TOKEN_URL=
OPENAI_COMPAT_OAUTH_REVOKE_URL=
OPENAI_COMPAT_OAUTH_CLIENT_ID=
OPENAI_COMPAT_OAUTH_CLIENT_SECRET=
OPENAI_COMPAT_OAUTH_SCOPES=
OPENAI_COMPAT_OAUTH_REDIRECT_URL=
OPENAI_COMPAT_OAUTH_LABEL=

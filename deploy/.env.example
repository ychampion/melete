# From the repository root: bun run deploy/scripts/configure.ts [--fake]
# Or copy this file to deploy/.env and fill every required value.
COMPOSE_PROJECT_NAME=melete

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Seals connection secrets and provider keys at rest. You hold it; losing it
# means re-entering every credential, which is the intended trade.
# Generate one with:  openssl rand -base64 32
MELETE_MASTER_KEY=

# Generate two independent values with: openssl rand -hex 32
# The API signs attempt capabilities; only the API holds the approval key.
MELETE_CAPABILITY_KEY=
MELETE_APPROVAL_KEY=

# Authenticates the warm runtime API. Real attempts get independent keys.
MELETE_RUNTIME_KEY=
# The trusted service supervises attempt containers; only it gets this group.
# Linux: stat -c %g /var/run/docker.sock
DOCKER_GID=

POSTGRES_USER=melete
POSTGRES_PASSWORD=
POSTGRES_DB=melete
DATABASE_URL=postgres://melete:CHANGE_ME@postgres:5432/melete

# ---------------------------------------------------------------------------
# Ports on the host
# ---------------------------------------------------------------------------

MELETE_PORT=3100
WEB_PORT=3101
# Optional HTTPS origin when putting the loopback web service behind a proxy.
MELETE_WEB_ORIGIN=

# ---------------------------------------------------------------------------
# Model providers
#
# Melete is model-agnostic. Set the key for whichever provider you want to use;
# they are injected by the gateway proxy and never reach the runtime container.
# The fake provider is a deterministic local deployment check, enabled only
# with configure.ts --fake. To use a real model, set its provider and model here.
# ---------------------------------------------------------------------------

MELETE_DEFAULT_PROVIDER=fireworks
MELETE_DEFAULT_MODEL=deepseek-v4p1-flash
MELETE_ENABLE_FAKE_PROVIDER=false
MELETE_ENABLE_TEST_CONNECTOR=false

FIREWORKS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Any OpenAI-compatible endpoint, including a local model server.
# For example: https://models.example.net/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

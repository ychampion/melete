# Copy to .env and fill in. `docker compose up` reads this file.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Seals connection secrets and provider keys at rest. You hold it; losing it
# means re-entering every credential, which is the intended trade.
# Generate one with:  openssl rand -base64 32
MELETE_MASTER_KEY=

# Generate two independent values with: openssl rand -hex 32
# The API signs attempt capabilities; only the API holds the approval key.
MELETE_CAPABILITY_KEY=
MELETE_APPROVAL_KEY=

# The group owning /var/run/docker.sock on this host (stat -c %g /var/run/docker.sock).
# Only the service receives this socket; it launches one restricted runtime per attempt.
DOCKER_GID=0

POSTGRES_USER=melete
POSTGRES_PASSWORD=
POSTGRES_DB=melete
DATABASE_URL=postgres://melete:CHANGE_ME@postgres:5432/melete

# ---------------------------------------------------------------------------
# Ports on the host
# ---------------------------------------------------------------------------

MELETE_PORT=8787
WEB_PORT=3000
MELETE_API_URL=http://localhost:8787

# ---------------------------------------------------------------------------
# Model providers
#
# Melete is model-agnostic. Set the key for whichever provider you want to use;
# they are injected by the gateway proxy and never reach the runtime container.
# The recommended, tested default is DeepSeek V4.1 Flash on Fireworks.
# ---------------------------------------------------------------------------

FIREWORKS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Any OpenAI-compatible endpoint, including a local model server.
# For example: https://models.example.net/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

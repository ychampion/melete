# From the repository root, with the provider's key in the environment:
#   bun run deploy/scripts/configure.ts [--provider name] [--model id] [--tailscale [--tailscale-hostname name]]
# or, for the scripted demonstration with no key:
#   bun run deploy/scripts/configure.ts --fake
# Or copy this file to deploy/.env and fill every required value.
COMPOSE_PROJECT_NAME=melete

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Seals connection secrets and provider keys at rest. You hold it; losing it
# means re-entering every credential, which is the intended trade.
# Generate one with:  openssl rand -base64 32
MELETE_MASTER_KEY=

# Generate two independent values with: openssl rand -hex 32
# The API signs attempt capabilities; only the API holds the approval key.
MELETE_CAPABILITY_KEY=
MELETE_APPROVAL_KEY=

# Authenticates the warm runtime API. Real attempts get independent keys.
MELETE_RUNTIME_KEY=
# The group of the Docker socket; only melete-cells, which holds the socket, gets it.
# Linux: stat -c %g /var/run/docker.sock
# Docker Desktop serves the socket from its VM, where its group is root (0);
# configure.ts measures it from a container.
DOCKER_GID=

# Postgres creates this user and database the first time it starts. configure.ts
# builds DATABASE_URL from them, so change them here before running it; by hand,
# keep DATABASE_URL naming the same user, password and database.
POSTGRES_USER=melete
POSTGRES_PASSWORD=
POSTGRES_DB=melete
DATABASE_URL=postgres://melete:CHANGE_ME@postgres:5432/melete
# Only database-roles is given DATABASE_URL. At each start it creates the roles
# melete_migrate, melete_api and melete_effects with it, migrates, and hands the
# service addresses of its own. Where the database's administrator creates the
# roles instead, set all three, at the same server and database
# (docs/DEPLOYMENT.md, "Database roles"); otherwise leave them empty.
MELETE_MIGRATE_DATABASE_URL=
MELETE_API_DATABASE_URL=
MELETE_EFFECTS_DATABASE_URL=

# ---------------------------------------------------------------------------
# Images
#
# Empty: Compose builds the images from this checkout (up --build). Set a tag
# to pull the published images instead and never build here: main follows the
# main branch, a release tag such as v0.3.0 stays on that release, and a short
# commit pins one build. Update with deploy/scripts/update.sh.
# See docs/DEPLOYMENT.md, "Using prebuilt images".
# ---------------------------------------------------------------------------

MELETE_IMAGE_TAG=
# Where the images are pulled from. Empty: ghcr.io/ychampion.
MELETE_IMAGE_REGISTRY=

# ---------------------------------------------------------------------------
# Ports on the host
# ---------------------------------------------------------------------------

MELETE_PORT=3100
WEB_PORT=3101
# Optional HTTPS origin when putting the loopback web service behind a proxy.
MELETE_WEB_ORIGIN=
# The web address sign-in links point at, for email sign-in (docs/CLIENT.md).
MELETE_PUBLIC_URL=
# Set to false when an https:// MELETE_PUBLIC_URL is reachable only on a private
# network or tailnet, so MCP sign-in registers dynamically (docs/CONNECTORS.md).
MELETE_OAUTH_CLIENT_METADATA=
# Your Google OAuth client, for signing in to Gmail and Google Calendar. Both,
# or neither. Setup and publishing status: docs/mail-calendar.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Your Microsoft Entra app, for signing in to Outlook mail and calendar. Both,
# or neither. The tenant is common (personal and work accounts) unless you name
# yours. Setup: docs/mail-calendar.md.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=
# Web Push to phones and browsers (docs/DEPLOYMENT.md, "Phone notifications").
# configure.ts writes this installation's own key pair; no third-party service.
# Generate by hand with: bun run deploy/scripts/vapid-keys.ts
MELETE_VAPID_PUBLIC_KEY=
MELETE_VAPID_PRIVATE_KEY=
# Who push services contact about this installation. Empty: mailto: the owner.
MELETE_VAPID_SUBJECT=
# Push endpoints outside the browser push services, comma separated. Leave empty.
MELETE_PUSH_EXTRA_ORIGINS=
# Melete notices meetings that move or overlap, deadlines at risk and messages
# still waiting on an answer, from the calendars and mailboxes people connect.
# false turns that off for this installation.
MELETE_DETECTORS=true

# ---------------------------------------------------------------------------
# Tailscale
#
# Read only by deploy/docker-compose.tailscale.yml, which reaches the web client
# from your own devices over your tailnet with HTTPS and publishes no host port.
# See docs/DEPLOYMENT.md, "Tailscale".
#
# TS_AUTHKEY is an auth key from the Tailscale admin console, or an OAuth client
# secret with ?ephemeral=false. It is a secret: keep this file private.
#
# TS_HOSTNAME becomes the node name, so the address is
# https://<TS_HOSTNAME>.<your tailnet>.ts.net. Once the node has joined, run
# `bun run deploy/scripts/tailscale-origin.ts` to write MELETE_WEB_ORIGIN.
#
# TS_EXTRA_ARGS passes further flags to the node, for example
# --advertise-tags=tag:melete, which an OAuth client secret requires.
# ---------------------------------------------------------------------------

TS_AUTHKEY=
TS_HOSTNAME=melete
TS_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# Model providers
#
# Melete is model-agnostic. Keys are injected by the gateway proxy and never
# reach the runtime container. The fake provider is a deterministic local
# deployment check, enabled only with configure.ts --fake.
#
# MELETE_DEFAULT_PROVIDER is one of exactly these names, and needs the key
# beside it:
#   fireworks          FIREWORKS_API_KEY
#   anthropic          ANTHROPIC_API_KEY
#   openai             OPENAI_API_KEY
#   google             GOOGLE_API_KEY
#   chatgpt            none: the owner signs in to ChatGPT through the sign-in
#                      routes (docs/DEPLOYMENT.md, "Signing in to a provider")
#   openai-compatible  OPENAI_COMPAT_BASE_URL, and OPENAI_COMPAT_API_KEY
#                      or the OPENAI_COMPAT_OAUTH_ settings below
# Any other name, or openai-compatible without a usable address, stops the
# service at start-up with a message naming the setting. An empty key for the
# selected provider is reported at start-up as a warning, and every model call
# is refused until it is set.
#
# MELETE_DEFAULT_MODEL is the identifier that provider serves, written exactly
# as its API expects it. Fireworks identifiers are full account paths.
# ---------------------------------------------------------------------------

MELETE_DEFAULT_PROVIDER=fireworks
MELETE_DEFAULT_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
# Whether that model reads images, so the agent sees its own screenshots as
# pictures: true or false. Left empty, Melete's model catalog decides.
MELETE_DEFAULT_MODEL_VISION=
# Whether that model searches the web with its provider's own search tool:
# true or false. Left empty, Melete's model catalog decides (Claude and recent
# OpenAI models do). false sends its searches to Melete's own search instead.
MELETE_DEFAULT_MODEL_NATIVE_SEARCH=
# The output limit given to a model request that names none, which is the usual
# ceiling on one reply. It is held against the job's output budget until the
# call settles, and never exceeds what the job has left.
MELETE_DEFAULT_MAX_OUTPUT_TOKENS=4096

# ---------------------------------------------------------------------------
# Web search
#
# Every agent can search the web with nothing set here: with its model's own
# search where the provider has one, and otherwise with a search that needs no
# key (DuckDuckGo, then Wikipedia). A search API key, when set, is used first.
# The owner turns web reads off per space in Settings. docs/CONNECTORS.md,
# "Web search".
#
# The keyless search reads DuckDuckGo's results page, which is meant for
# people, from this server's address. It is not an official API and its terms
# may not allow it; Melete paces it (one request at a time, two seconds apart,
# repeated queries reused for ten minutes, a fifteen-minute pause after a robot
# check), but DuckDuckGo can still block the address. For a hosted or shared
# installation, set one of these keys.
#
# TAVILY_API_KEY is asked first when both are set: its results carry the
# passages of each page that match the query, and with it web.fetch also reads
# a public page that gave a direct read no text (a page built by scripts, or
# one behind a bot wall) through Tavily Extract, at most three pages a turn.
# Its free plan includes 1,000 credits a month; a search costs one, an
# extracted page at most two, and both count toward the spending limits below.
# ---------------------------------------------------------------------------
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

MELETE_ENABLE_FAKE_PROVIDER=false
MELETE_ENABLE_TEST_CONNECTOR=false

# Engine limits for each attempt; empty keeps the default. docs/DEPLOYMENT.md,
# "Engine limits", says what each one does.
#   MELETE_ENGINE_MAX_TURNS       iterations one run may take (default 150)
#   MELETE_COMPACTION_MAX_TOKENS  conversation size that triggers a summary (default 200000)
#   MELETE_MODEL_CONTEXT_WINDOW   the served model's context window, when it is smaller
MELETE_ENGINE_MAX_TURNS=
MELETE_COMPACTION_MAX_TOKENS=
MELETE_MODEL_CONTEXT_WINDOW=

# Automatic memory reads what people say in chat with this model; empty uses the
# default provider and model, and `off` keeps structured observations only.
# MELETE_MEMORY_DAILY_CALLS is how many reads one person's memory may make a day.
MELETE_MEMORY_MODEL=
MELETE_MEMORY_PROVIDER=
MELETE_MEMORY_DAILY_CALLS=200

# Semantic recall embeds memory with the default provider's embedding model
# (Fireworks, OpenAI or Google); with none, recall stays lexical. These name
# another model, `local` as the provider embeds on MELETE_LOCAL_MODEL_URL, and
# MELETE_EMBEDDING_MODEL=off turns it off. docs/DEPLOYMENT.md, "Semantic recall".
MELETE_EMBEDDING_PROVIDER=
MELETE_EMBEDDING_MODEL=
MELETE_EMBEDDING_DIMENSIONS=

# The company map reads mail with the default model; these name another model
# and provider for scans alone. MELETE_COMPANIES_DAILY_CALLS is how many model
# calls one person's scans may make in 24 hours; empty means 500.
# docs/DEPLOYMENT.md, "Company map".
MELETE_COMPANIES_MODEL=
MELETE_COMPANIES_PROVIDER=
MELETE_COMPANIES_DAILY_CALLS=

# Auto-review asks this model whether a reversible action may go ahead without
# the person; empty uses the model chosen in the app (else the default provider
# and model), and `off` sends every such action to the person. A review longer
# than the timeout, or past the hourly limit for one space, also goes to the
# person.
MELETE_REVIEW_MODEL=
MELETE_REVIEW_PROVIDER=
MELETE_REVIEW_TIMEOUT_MS=12000
MELETE_REVIEW_HOURLY_LIMIT=60
# Undo send: seconds a message waits after it is cleared to go, while it can
# still be cancelled from its receipt (0 to 120; 0 sends at once).
MELETE_SEND_HOLD_SECONDS=20

# Spending caps on model calls, in estimated US dollars and in tokens, for the
# whole installation and for each person, per UTC day and month. Empty is no
# limit. At MELETE_SPEND_NOTICE_PERCENT (default 80) the person sees a notice;
# at the limit new model calls are refused until it resets. MELETE_MODEL_PRICES
# replaces the built-in price estimates, as JSON per million tokens.
# docs/DEPLOYMENT.md, "Spending caps".
MELETE_SPEND_MONTHLY_USD=
MELETE_SPEND_DAILY_USD=
MELETE_SPEND_PERSON_MONTHLY_USD=
MELETE_SPEND_PERSON_DAILY_USD=
MELETE_SPEND_MONTHLY_TOKENS=
MELETE_SPEND_DAILY_TOKENS=
MELETE_SPEND_PERSON_MONTHLY_TOKENS=
MELETE_SPEND_PERSON_DAILY_TOKENS=
MELETE_SPEND_NOTICE_PERCENT=
MELETE_MODEL_PRICES=
# Each person's background model calls alone (watches, standing runs,
# routines, memory, learning). A person's own messages never count here and
# are never held back by them. Empty is no limit. docs/BACKGROUND-COMPUTE.md.
MELETE_SPEND_PERSON_BACKGROUND_MONTHLY_USD=
MELETE_SPEND_PERSON_BACKGROUND_DAILY_USD=
MELETE_SPEND_PERSON_BACKGROUND_MONTHLY_TOKENS=
MELETE_SPEND_PERSON_BACKGROUND_DAILY_TOKENS=
# true counts each job's model calls against its dollar limit, beside its actions.
MELETE_JOB_USD_COUNTS_MODELS=

# Files sent in chat. The largest file in MB (default 20, at most 100) and the
# most files in one message (default 10, at most 100). Uploads per person are
# not limited by default; a hosted install can limit how many one person has
# under way at once and how many they may start in a window of minutes
# (default 10). docs/DEPLOYMENT.md, "Attachments".
MELETE_ATTACHMENT_MAX_MB=
MELETE_ATTACHMENTS_PER_MESSAGE=
MELETE_ATTACHMENT_UPLOADS_AT_ONCE=
MELETE_ATTACHMENT_UPLOADS_PER_WINDOW=
MELETE_ATTACHMENT_UPLOAD_WINDOW_MINUTES=
# Always on, for the service's own sake: uploads it holds in flight at once from
# everyone (default 16) and the MB they may hold between them (default 384).
# One person may hold at most half of each.
MELETE_ATTACHMENT_SERVER_UPLOADS=
MELETE_ATTACHMENT_SERVER_UPLOAD_MB=

# Model routing, each provider/model: a fast model for memory reads, voice
# asides, reviews and scans; a vision model for agent requests with pictures;
# fallbacks, comma-separated, for a provider that limits or fails. Reasoning
# effort per role: off, none, low, medium or high (defaults medium and low).
# docs/DEPLOYMENT.md, "Model routing".
MELETE_MODEL_FAST=
MELETE_MODEL_VISION=
MELETE_MODEL_FALLBACK=
MELETE_REASONING_EFFORT_AGENT=
MELETE_REASONING_EFFORT_SIDE=

# Sorting new mail and calendar changes into needs you, for your information,
# or ignore, for Home's "Needs you" list: a provider/model, or off. Unset, it
# uses the owner's secondary model for scheduled work, else MELETE_MODEL_FAST,
# else the default. Its calls are background calls, held to the
# MELETE_SPEND_PERSON_BACKGROUND_* limits. How often it runs, in seconds
# (default 120). docs/SITUATIONAL-AWARENESS.md, "Sorting what came in".
MELETE_MODEL_TRIAGE=
MELETE_TRIAGE_INTERVAL_SECONDS=

# Alerts when the service is unhealthy: a webhook (JSON POST) and/or email via
# an SMTP server (smtps://user:password@host:465). MELETE_OPERATOR_TOKEN opens
# GET /health/detail. docs/DEPLOYMENT.md, "Alerts".
MELETE_ALERT_WEBHOOK_URL=
MELETE_ALERT_EMAIL_TO=
MELETE_ALERT_EMAIL_FROM=
MELETE_ALERT_SMTP_URL=
MELETE_ALERT_INTERVAL_SECONDS=
MELETE_ALERT_REPEAT_MINUTES=
MELETE_OPERATOR_TOKEN=
# Spending alerts, off unless set: the last hour above this many times the
# usual hour; one person above this percent of today's spending. Neither fires
# below MELETE_ALERT_SPEND_MIN_USD (default 1).
MELETE_ALERT_SPEND_HOURLY_MULTIPLE=
MELETE_ALERT_SPEND_PERSON_PERCENT=
MELETE_ALERT_SPEND_MIN_USD=

FIREWORKS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# One OpenAI-compatible endpoint of your choosing, selected with
# MELETE_DEFAULT_PROVIDER=openai-compatible whatever software serves it.
# Give the version prefix, for example https://models.example.net/v1
#
# This is the only provider address that may be plain http://, for a model
# server on your own machine or network, for example http://192.168.1.20:11434/v1
# Over http:// the key and every prompt travel unencrypted, so keep it to a
# network you trust. Inside Compose, localhost is the Melete container itself:
# use an address the container can reach.
#
# The gateway refuses a provider with an empty key. If your server checks no
# key, set OPENAI_COMPAT_API_KEY to any non-empty value. Left empty, an https://
# endpoint falls back to OPENAI_API_KEY; a plain http:// endpoint never
# receives OPENAI_API_KEY.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# The text-to-speech model, used when OPENAI_API_KEY or OPENAI_COMPAT_BASE_URL is
# set. Empty uses gpt-4o-mini-tts.
MELETE_SPEECH_MODEL=

# The OAuth client ChatGPT sign-in presents. Left empty, it is the Codex CLI's
# public client, the one OpenAI has registered for this sign-in.
MELETE_CHATGPT_CLIENT_ID=

# OAuth for the OpenAI-compatible endpoint, for a provider that issues access
# tokens rather than keys. Register OPENAI_COMPAT_OAUTH_REDIRECT_URL with the
# provider, give its issuer (or its authorize and token addresses), and the
# owner signs in from Melete. The token is then used instead of
# OPENAI_COMPAT_API_KEY. Signing in needs MELETE_MASTER_KEY.
# OPENAI_COMPAT_OAUTH_LABEL names the provider on the sign-in button.
OPENAI_COMPAT_OAUTH_ISSUER=
OPENAI_COMPAT_OAUTH_AUTHORIZE_URL=
OPENAI_COMPAT_OAUTH_TOKEN_URL=
OPENAI_COMPAT_OAUTH_REVOKE_URL=
OPENAI_COMPAT_OAUTH_CLIENT_ID=
OPENAI_COMPAT_OAUTH_CLIENT_SECRET=
OPENAI_COMPAT_OAUTH_SCOPES=
OPENAI_COMPAT_OAUTH_REDIRECT_URL=
OPENAI_COMPAT_OAUTH_LABEL=

# ---------------------------------------------------------------------------
# Voice (docs/VOICE.md)
#
# An ElevenLabs key turns on speech, transcription, push-to-talk in chat and
# voice mode. Speech uses it in preference to OPENAI_API_KEY. The key stays in
# the service: voice mode hands the browser a single-use token instead.
# Voices and models left empty use the defaults docs/VOICE.md names.
# ---------------------------------------------------------------------------

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_SECOND_VOICE_ID=
ELEVENLABS_SPEECH_MODEL=
ELEVENLABS_STREAMING_MODEL=
ELEVENLABS_TRANSCRIPTION_MODEL=
# What one person may use in a day: seconds of voice messages transcribed,
# characters of replies read aloud, and voice conversations started.
MELETE_VOICE_DAILY_SECONDS=1800
MELETE_VOICE_DAILY_CHARACTERS=20000
MELETE_VOICE_DAILY_SESSIONS=30

# ---------------------------------------------------------------------------
# Storage (docs/DEPLOYMENT.md, Storage)
#
# Files the service keeps by their content are stored on the artifacts volume.
# To keep them in an S3-compatible bucket instead (AWS S3, Cloudflare R2,
# MinIO and the like), set MELETE_BLOB_STORE=s3, the bucket and its keys. The
# keys stay with the service and never reach an agent's computer.
#   MELETE_BLOB_S3_ENDPOINT   the service's address; empty is AWS for the region
#   MELETE_BLOB_S3_REGION     (us-east-1)
#   MELETE_BLOB_S3_PREFIX     keys go under it, so installations can share a bucket
# ---------------------------------------------------------------------------

MELETE_BLOB_STORE=
MELETE_BLOB_S3_ENDPOINT=
MELETE_BLOB_S3_BUCKET=
MELETE_BLOB_S3_REGION=
MELETE_BLOB_S3_PREFIX=
MELETE_BLOB_S3_ACCESS_KEY_ID=
MELETE_BLOB_S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Sandboxes
#
# Connect E2B, Modal or Daytona in Settings, under Connections, Sandbox. The
# provider's key is entered there and sealed with MELETE_MASTER_KEY.
#
# Or give every agent a computer of its own on this host's Docker engine, with
# no account and no key: set MELETE_SANDBOX_PROVIDER=docker and build the image
# with --profile sandbox (docs/sandbox-docker.md).
#
# MELETE_SANDBOX_PROJECT labels the sandboxes this installation owns at the
# provider, so installations sharing one provider account never touch each
# other's. configure.ts writes a random one; keep it, since changing it
# orphans what the old value labelled. Lower-case letters, digits and hyphens.
#
# The rest are optional; empty uses the default in brackets.
#   MELETE_SANDBOX_LEASE_SECONDS                  idle time before a session ends (900)
#   MELETE_SANDBOX_MAX_CONCURRENT                 sandboxes running at once (4)
#   MELETE_SANDBOX_MAX_CONCURRENT_PER_CONNECTION  per connection (the ceiling above)
#   MELETE_SANDBOX_WORKSPACE_RETENTION_SECONDS    how long a suspended workspace is kept (604800)
#   MELETE_SANDBOX_SNAPSHOT_TTL_SECONDS           provider snapshot lifetime, longer than retention (2592000)
#   MELETE_SANDBOX_ALLOW_PROXY_ENVIRONMENT        true to let Modal use this host's proxy settings (false)
#   MELETE_PROCESS_MAX_PER_COMPUTER               background processes per agent's computer (4)
#   MELETE_PROCESS_MAX_PER_SPACE                  background processes per space (8)
#   MELETE_PROCESS_DEFAULT_TTL_MINUTES            a process's time limit when none is given (120)
#   MELETE_PROCESS_MAX_TTL_MINUTES                the longest time limit a process may have (720)
#   MELETE_PROCESS_OUTPUT_MAX_BYTES               output a process keeps in the computer (8388608)
#   MELETE_SANDBOX_AWAKE_SECONDS_PER_DAY          time processes may keep a space's computers running per day (21600)
#   MELETE_E2B_PLAN                               hobby or pro, as the E2B account is (hobby)
#   MELETE_SANDBOX_PROVIDER                       docker for a computer per agent on this engine (none)
#   MELETE_SANDBOX_DOCKER_IMAGE                   the image it starts from (melete-sandbox:local)
#   MELETE_SANDBOX_DOCKER_CPUS                    CPUs one computer may use (1)
#   MELETE_SANDBOX_DOCKER_MEMORY_MB               its memory, with no swap beyond it (2048)
#   MELETE_SANDBOX_DOCKER_PIDS                    processes it may run at once (512)
#   MELETE_SANDBOX_DOCKER_DISK_MB                 what its files may hold, checked before each command (4096)
#   MELETE_SANDBOX_DOCKER_EGRESS                  open for public HTTPS sites, connected_hosts_only for the
#                                                 hosts listed below, deny_all for nothing (open)
#   MELETE_SANDBOX_DOCKER_IDLE_SECONDS            unused this long, it is stopped until used again (900)
#   MELETE_SANDBOX_EGRESS_PORT                    where the service's egress guard listens (8791)
#   MELETE_SANDBOX_EGRESS_EXTRA_HOSTS             the hosts connected_hosts_only reaches, comma-separated;
#                                                 .example.com covers the names below it (none)
#   MELETE_EGRESS_RECORD_DAYS                     days the record of where computers connected is kept (30)
#   MELETE_TRASH_DAYS                             days a deleted file stays in the trash, restorable (7)
#   MELETE_TRASH_MAX_MB                           most one conversation's trash holds; oldest goes first (1024)
#   MELETE_EGRESS_HOLD_MAX_BYTES                  largest change from the command line held for approval (64 MiB)
#   MELETE_EGRESS_APPROVAL_HOLD_SECONDS           how long such a change waits inside its command for an answer (90)
# ---------------------------------------------------------------------------

MELETE_SANDBOX_PROJECT=
MELETE_SANDBOX_LEASE_SECONDS=
MELETE_SANDBOX_MAX_CONCURRENT=
MELETE_SANDBOX_MAX_CONCURRENT_PER_CONNECTION=
MELETE_SANDBOX_WORKSPACE_RETENTION_SECONDS=
MELETE_SANDBOX_SNAPSHOT_TTL_SECONDS=
MELETE_SANDBOX_ALLOW_PROXY_ENVIRONMENT=
MELETE_PROCESS_MAX_PER_COMPUTER=
MELETE_PROCESS_MAX_PER_SPACE=
MELETE_PROCESS_DEFAULT_TTL_MINUTES=
MELETE_PROCESS_MAX_TTL_MINUTES=
MELETE_PROCESS_OUTPUT_MAX_BYTES=
MELETE_SANDBOX_AWAKE_SECONDS_PER_DAY=
MELETE_E2B_PLAN=
MELETE_SANDBOX_PROVIDER=
MELETE_SANDBOX_DOCKER_IMAGE=
MELETE_SANDBOX_DOCKER_CPUS=
MELETE_SANDBOX_DOCKER_MEMORY_MB=
MELETE_SANDBOX_DOCKER_PIDS=
MELETE_SANDBOX_DOCKER_DISK_MB=
MELETE_SANDBOX_DOCKER_EGRESS=
MELETE_SANDBOX_DOCKER_IDLE_SECONDS=
MELETE_SANDBOX_EGRESS_PORT=
MELETE_SANDBOX_EGRESS_EXTRA_HOSTS=
MELETE_EGRESS_RECORD_DAYS=
MELETE_TRASH_DAYS=
MELETE_TRASH_MAX_MB=
MELETE_EGRESS_HOLD_MAX_BYTES=
MELETE_EGRESS_APPROVAL_HOLD_SECONDS=

# ---------------------------------------------------------------------------
# Plugins and attempts
#
# Optional; empty uses the default in brackets. docs/DEPLOYMENT.md, "Isolation
# and image provenance".
#   MELETE_MCP_NODE_IMAGE            the image npx plugins run in (node:22-alpine, pinned)
#   MELETE_MCP_PYTHON_IMAGE          the image uvx plugins run in (uv python3.12-alpine, pinned)
#   MELETE_MCP_EGRESS_PORT           the plugin proxy's port inside the service (8789)
#   MELETE_MCP_IDLE_MS               how long a plugin may sit unused (600000)
#   MELETE_RUNTIME_START_TIMEOUT_MS  how long an attempt may take to start (120000)
#   MELETE_ENGINE_PREWARM            engines kept loaded ahead of the next attempts (1; 0 for none)
#   MELETE_ATTEMPT_CONCURRENCY       attempts that run at once; more wait for a free slot (4)
# ---------------------------------------------------------------------------

MELETE_MCP_NODE_IMAGE=
MELETE_MCP_PYTHON_IMAGE=
MELETE_MCP_EGRESS_PORT=
MELETE_MCP_IDLE_MS=
MELETE_RUNTIME_START_TIMEOUT_MS=
MELETE_ENGINE_PREWARM=
MELETE_ATTEMPT_CONCURRENCY=

# ---------------------------------------------------------------------------
# Browser worker
#
# Read only by deploy/docker-compose.browser.yml, which adds the sandboxed
# browser the agent fills web forms in. Uncomment both before starting with
# that file, and follow docs/browser-worker.md for the connection entry and the
# space directory it needs.
#   MELETE_BROWSER_SPACE  the id of the space the browser works for
#   MELETE_BROWSER_TOKEN  a shared secret of at least 32 characters:
#                         openssl rand -hex 32
# ---------------------------------------------------------------------------

# MELETE_BROWSER_SPACE=
# MELETE_BROWSER_TOKEN=

# The computer an agent works in: one container per agent, started by the
# service's docker sandbox provider on the host's own engine. A shell with the
# usual tools, Python, git, gh and aws, and a desktop the size of the live view
# with a browser on it. It holds no Melete configuration, credential or client.
#
# The base is the runtime image's own, by digest, so an engine that already
# runs attempts has it and pulls only what the desktop adds.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

COPY deploy/sandbox/requirements.txt /tmp/requirements.txt

# Screenshots and the live view read the display through Pillow's XCB support,
# which the last line checks the wheel has.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates coreutils curl file findutils git jq less procps unzip xz-utils \
        xvfb openbox xdotool chromium fonts-dejavu-core fonts-liberation \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
    && pip install --no-cache-dir --no-deps --only-binary=:all: --require-hashes -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt \
    && groupadd --gid 10004 agent \
    && useradd --uid 10004 --gid 10004 --home-dir /home/agent --create-home --shell /bin/bash agent \
    && mkdir -p /work \
    && chown 10004:10004 /work \
    # The display server writes its compiled keymap here; the root is read-only at run time.
    && rm -rf /var/lib/xkb \
    && ln -s /tmp /var/lib/xkb \
    && python3 -c "from PIL import features; import sys; sys.exit(0 if features.check('xcb') else 1)"

# GitHub's command line, pinned by version and checksum. It never holds a
# token: a connected account reaches it as a placeholder, and the service's
# egress relay adds the real token on the wire.
ARG GH_VERSION=2.83.2
ARG TARGETARCH
RUN arch="${TARGETARCH:-amd64}" \
    && case "$arch" in \
        amd64) sum=ca6e7641214fbd0e21429cec4b64a7ba626fd946d8f9d6d191467545b092015e ;; \
        arm64) sum=b1a0c0a0fcf18524e36996caddc92a062355ed014defc836203fe20fba75a38e ;; \
        *) echo "gh is pinned for amd64 and arm64 only, not $arch" >&2; exit 1 ;; \
    esac \
    && curl -fsSL -o /tmp/gh.tar.gz \
        "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${arch}.tar.gz" \
    && echo "${sum}  /tmp/gh.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/gh.tar.gz -C /tmp \
    && install -m 0755 "/tmp/gh_${GH_VERSION}_linux_${arch}/bin/gh" /usr/local/bin/gh \
    && rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_${arch}" \
    && gh --version

# AWS's command line, version 2, pinned by version and checksum (the archives
# AWS signs). It never holds a key: a connected account reaches it as a
# placeholder key, and the service's egress relay signs each request again.
ARG AWS_CLI_VERSION=2.37.8
RUN arch="${TARGETARCH:-amd64}" \
    && case "$arch" in \
        amd64) name=x86_64; sum=6a2f98fee0901ff623ff9abb5c80f4d67c40e5c0ac5e2ad7afa2ba756a7d5088 ;; \
        arm64) name=aarch64; sum=00c4bac1cac8624b728d991f821428d5de1e0cb56e3803045b85bff63bedee8b ;; \
        *) echo "the aws command line is pinned for amd64 and arm64 only, not $arch" >&2; exit 1 ;; \
    esac \
    && curl -fsSL -o /tmp/awscli.zip \
        "https://awscli.amazonaws.com/awscli-exe-linux-${name}-${AWS_CLI_VERSION}.zip" \
    && echo "${sum}  /tmp/awscli.zip" | sha256sum -c - \
    && unzip -q /tmp/awscli.zip -d /tmp \
    && /tmp/aws/install --bin-dir /usr/local/bin --install-dir /usr/local/aws-cli \
    && rm -rf /tmp/awscli.zip /tmp/aws \
    && aws --version

COPY deploy/sandbox/melete-desktop deploy/sandbox/melete-sandbox-init /usr/local/bin/
RUN chmod 0755 /usr/local/bin/melete-desktop /usr/local/bin/melete-sandbox-init

# The root filesystem is read-only at run time. pip falls back to installing
# for the user, into the home volume, which keeps them across restarts.
ENV HOME=/home/agent \
    USER=agent \
    DISPLAY=:0 \
    PATH=/home/agent/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

USER 10004:10004
WORKDIR /work

CMD ["/usr/local/bin/melete-sandbox-init"]

{
  "name": "melete",
  "version": "0.1.0-pre",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "1.4.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  },
  "description": "An open-source, self-hosted, model-agnostic personal assistant.",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc -b && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test --max-concurrency=2 --timeout=30000",
    "test:plugin": "uv run --no-project --python 3.12 --with pytest==9.1.1 --with aiohttp==3.14.3 python -m pytest packages/runtime-hermes/tests -q",
    "openapi": "bun run packages/contracts/scripts/openapi.ts",
    "compose:check": "bun run deploy/scripts/compose-check.ts",
    "browser:compose:check": "bun run deploy/scripts/browser-compose-check.ts",
    "conformance": "bun run conformance/run.ts",
    "conformance:memory": "bun run conformance/memory/run.ts",
    "knowledge:lint": "bun run packages/knowledge/src/cli/lint.ts",
    "db:generate": "bun run --cwd apps/melete db:generate",
    "client:generate": "bun run packages/client/scripts/generate.ts",
    "dev:mock": "bun run --cwd apps/mock-api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "evals": "bun run evals/run.ts"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "conformance",
    "evals"
  ]
}

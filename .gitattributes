* text=auto eol=lf

# What a container executes or reads stays LF on a Windows checkout, whatever
# core.autocrlf says: a shell script with CRLF endings fails inside Linux. The
# directories are text=auto so a binary added to them is still found binary.
deploy/config/** text=auto eol=lf
packages/runtime-hermes/** text eol=lf
*.sh text eol=lf
*.py text eol=lf
Dockerfile* text eol=lf
deploy/.env.example text eol=lf

*.png binary
*.jpg binary
*.gif binary

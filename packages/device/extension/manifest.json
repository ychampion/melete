{
  "manifest_version": 3,
  "name": "Melete",
  "version": "0.1.0",
  "description": "Lets your Melete agent use this browser, signed in as you, while you switch it on. Every click and entry waits for your approval in Melete.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "tabs", "tabGroups", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Melete", "default_popup": "popup.html" }
}

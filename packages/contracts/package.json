{
  "name": "@melete/contracts",
  "version": "0.1.0-pre",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Zod schemas, TypeScript types, the job state machine, and the OpenAPI document for Melete.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./openapi.json": "./openapi.json",
    "./redact": {
      "types": "./src/redact.ts",
      "default": "./src/redact.ts"
    },
    "./agent-library": {
      "types": "./src/agent-library.ts",
      "default": "./src/agent-library.ts"
    },
    "./mention": {
      "types": "./src/mention.ts",
      "default": "./src/mention.ts"
    },
    "./attachments": {
      "types": "./src/attachments.ts",
      "default": "./src/attachments.ts"
    }
  },
  "scripts": {
    "openapi": "bun run scripts/openapi.ts",
    "test": "bun test"
  },
  "dependencies": {
    "re2js": "2.8.6",
    "zod": "4.6.2",
    "zod-openapi": "6.0.2"
  }
}
